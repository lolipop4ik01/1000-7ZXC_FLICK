    name.Parent = wrap

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0, 56, 0, 22)
    box.Position = UDim2.new(1, -68, 0, 4)
    box.BackgroundColor3 = Theme.boxBg
    box.BorderSizePixel = 0
    box.TextColor3 = Theme.text
