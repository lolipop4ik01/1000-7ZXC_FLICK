-- ===================== CONNECTIONS LEDGER =====================
-- Всё, что нужно рвать при teardown/пересборке. Каждый connect идёт
-- через add() — руками :Connect не дёргаем.
local connections = {}

local function add(conn)
    table.insert(connections, conn)
    return conn
end

local function tearDown()
    for i = #connections, 1, -1 do
        pcall(function() connections[i]:Disconnect() end)
        connections[i] = nil
    end
end

