    visualPart.CanCollide = false
    visualPart.CanQuery = false
    visualPart.CanTouch = false
    visualPart.Transparency = 0.3
    visualPart.Parent = Workspace
    
    visualAttach0 = Instance.new("Attachment")
    visualAttach0.Name = "FlickVisualAttach0"
    visualAttach1 = Instance.new("Attachment")
    visualAttach1.Name = "FlickVisualAttach1"
    visualAttach1.Parent = visualPart
    
    visualBeam = Instance.new("Beam")
    visualBeam.Name = "FlickPredictBeam"
    visualBeam.Attachment0 = visualAttach0
    visualBeam.Attachment1 = visualAttach1
    visualBeam.Width0 = 0.15
    visualBeam.Width1 = 0.15
    visualBeam.FaceCamera = true
    visualBeam.Color = ColorSequence.new(Color3.fromRGB(255, 50, 50))
    visualBeam.Transparency = NumberSequence.new(0.5)
    visualBeam.Parent = visualPart
end

local function updateVisualizer()
    if not Config.ShowPredictVisual then
        if visualPart then visualPart.Transparency = 1 end
        if visualBeam then visualBeam.Enabled = false end
        return
    end
    
    local murderer = findMurderer()
    if not murderer or not murderer.Character then
        if visualPart then visualPart.Transparency = 1 end
        if visualBeam then visualBeam.Enabled = false end
        return
    end
    
    local targetPart = murderer.Character:FindFirstChild(Config.TargetPart)
    if not targetPart then
        targetPart = murderer.Character:FindFirstChild("HumanoidRootPart")
    end
    if not targetPart then
        if visualPart then visualPart.Transparency = 1 end
        if visualBeam then visualBeam.Enabled = false end
        return
    end
    
    createVisualizer()
    
    local predPos = getPredictedPosition(targetPart)
    visualPart.Position = predPos
    visualPart.Transparency = 0.3
    visualBeam.Enabled = true
    
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        visualAttach0.Parent = hrp
        visualAttach0.Position = Vector3.new(0, 1, 0)
    else
        visualAttach0.Parent = visualPart
        visualAttach0.Position = Vector3.zero
    end
end

-- ========== GUI ДРЭГ ==========
local DragSystem = {}
function DragSystem.MakeDraggable(gui, dragArea, onPositionChanged)
    local dragging, dragStart, startPos = false, nil, nil
    dragArea.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; dragStart = input.Position; startPos = gui.Position
        end
    end)
    dragArea.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 and dragging then
            dragging = false
            if onPositionChanged then onPositionChanged({xs = gui.Position.X.Scale, xo = gui.Position.X.Offset, ys = gui.Position.Y.Scale, yo = gui.Position.Y.Offset}) end
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            gui.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

-- ========== ЛОГИКА FLICK ==========
local lastCameraCFrame = nil
local returnToken = 0

function findMurderer()
    if game.PlaceId == 142823291 then
        local success, roleData = pcall(function()
            local remote = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
            if remote and remote:IsA("RemoteFunction") then return remote:InvokeServer() end
        end)
        if success and roleData then
            for playerName, data in pairs(roleData) do
                if data.Role == "Murderer" and not data.Killed and not data.Dead then
                    local p = Players:FindFirstChild(playerName)
                    if p then return p end
                end
            end
        end
        return nil
    else
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local char = player.Character
                local root = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChild("Humanoid")
                if root and hum and hum.Health > 0 then
                    if player:FindFirstChild("Backpack") and player.Backpack:FindFirstChild("Knife") then return player end
                    for _, tool in ipairs(char:GetChildren()) do
                        if tool:IsA("Tool") and tool.Name == "Knife" then return player end
                    end
                end
            end
        end
        return nil
    end
end

local function findShootRemote()
    local ns = ReplicatedStorage:FindFirstChild("Axioria Solver was here.")
    if not ns then return nil end
    for _, v in ipairs(ns:GetChildren()) do
        if v:IsA("RemoteEvent") then return v end
    end
    return nil
end

local function autoShoot(murderer)
    if not Config.AutoShoot then return end
    if not murderer or not murderer.Character then return end
    local targetPart = murderer.Character:FindFirstChild(Config.TargetPart) or murderer.Character:FindFirstChild("HumanoidRootPart")
    if not targetPart then return end
    local targetPos = getPredictedPosition(targetPart)
    if not targetPos then return end
    
    local remote = findShootRemote()
    if remote then
        pcall(function() remote:FireServer({ workspace.CurrentCamera.CFrame, CFrame.new(targetPos) }) end)
    end
    
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        local gun = char:FindFirstChild("Gun") or (backpack and backpack:FindFirstChild("Gun"))
        if gun and gun:IsA("Tool") and hum then
            if gun.Parent ~= char then
                pcall(function() hum:EquipTool(gun) end)
                task.wait(0.1)
            end
            pcall(function() gun:Activate() end)
            pcall(function()
                local vu = game:GetService("VirtualUser")
                vu:Button1Down(Vector2.zero)
                vu:Button1Up(Vector2.zero)
            end)
        end
    end
end

local function returnCameraWithRandomness(token)
    if token and token ~= returnToken then return end
    if not Config.ReturnCamera or not lastCameraCFrame then return end
    local cam = workspace.CurrentCamera
    local randomX = (math.random() - 0.5) * 2 * (Config.ReturnRandomnessX / 100)
    local randomY = (math.random() - 0.5) * 2 * (Config.ReturnRandomnessY / 100)
    local newLook = (lastCameraCFrame.LookVector + lastCameraCFrame.RightVector * randomX + lastCameraCFrame.UpVector * randomY).Unit
    local targetCFrame = CFrame.lookAt(lastCameraCFrame.Position, lastCameraCFrame.Position + newLook)
    local oldCFrame = cam.CFrame
    local angleDist = math.acos(math.clamp(oldCFrame.LookVector:Dot(targetCFrame.LookVector), -1, 1))
    local totalTime = math.clamp(angleDist / (Config.ReturnSpeed * 2), 0.01, 0.35)
    local steps = math.clamp(math.floor(60 * totalTime), 8, 40)
    for i = 1, steps do
        if token and token ~= returnToken then return end
        cam.CFrame = oldCFrame:Lerp(targetCFrame, i / steps)
        task.wait(totalTime / steps)
    end
    lastCameraCFrame = nil
end

function flickToMurderer()
    if not Config.Enabled then notify("Flick is disabled!", 1) return end
    local murderer = findMurderer()
    if not murderer then notify("Murderer not found!", 1) return end
    
    local cam, char = workspace.CurrentCamera, LocalPlayer.Character
    if not char then return end
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    if Config.ReturnCamera then lastCameraCFrame = cam.CFrame end
    
    local targetPart = murderer.Character:FindFirstChild(Config.TargetPart) or murderer.Character:FindFirstChild("HumanoidRootPart")
    if not targetPart then notify("Target part not found!", 1) return end
    local targetPos = getPredictedPosition(targetPart)
    if not targetPos then notify("Cannot get target position!", 1) return end
    
    -- Поворачиваем тело в сторону цели (идеальный центр)
    local flatTarget = Vector3.new(targetPos.X, rootPart.Position.Y, targetPos.Z)
    local dir = (flatTarget - rootPart.Position)
    if dir.Magnitude < 0.01 then return end
    local newHRPCFrame = CFrame.lookAt(rootPart.Position, rootPart.Position + dir.Unit)
    
    local headPos = char:FindFirstChild("Head") and char.Head.Position or rootPart.Position
    local isFirstPerson = (cam.CFrame.Position - headPos).Magnitude < 5
    
    local newCamCFrame
    if isFirstPerson then
        newCamCFrame = CFrame.lookAt(cam.CFrame.Position, targetPos)
    else
        local distance = (cam.CFrame.Position - rootPart.Position).Magnitude
        newCamCFrame = CFrame.lookAt(rootPart.Position + (targetPos - rootPart.Position).Unit * distance, targetPos)
    end
    
    if Config.InstantFlick then
        rootPart.CFrame = newHRPCFrame
        cam.CFrame = newCamCFrame
    else
        local oldCFrame = cam.CFrame
        local oldHRP = rootPart.CFrame
        local angleDist = math.acos(math.clamp(oldCFrame.LookVector:Dot((targetPos - oldCFrame.Position).Unit), -1, 1))
        local totalTime = math.clamp(angleDist / (Config.FlickSpeed * 2), 0.01, 0.35)
        local steps = math.clamp(math.floor(60 * totalTime), 8, 40)
        for i = 1, steps do
            if not rootPart.Parent then break end
            local alpha = i / steps
            rootPart.CFrame = oldHRP:Lerp(newHRPCFrame, alpha)
            cam.CFrame = oldCFrame:Lerp(newCamCFrame, alpha)
            task.wait(totalTime / steps)
        end
    end
    
    autoShoot(murderer)
    
    if Config.ReturnCamera then
        returnToken = returnToken + 1
        local myToken = returnToken
        task.spawn(function()
            task.wait(Config.ReturnDelay / 1000)
            returnCameraWithRandomness(myToken)
        end)
    end
end

-- ========== KEYBIND ==========
local waitingForBind = false
local function setupKeybind()
    if getgenv().KeybindConnection then pcall(function() getgenv().KeybindConnection:Disconnect() end) end
    getgenv().KeybindConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if waitingForBind then
            waitingForBind = false
            if input.KeyCode ~= Enum.KeyCode.Unknown then
                Config.Keybind = input.KeyCode.Name
                saveConfig()
                notify("Keybind set to: " .. Config.Keybind, 1)
            end
            return
        end
        if input.KeyCode == Enum.KeyCode[Config.Keybind] then flickToMurderer() end
    end)
end

