-- ===================== V2-PREDICT =====================
local function getPingSeconds()
    local ok, v = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    return ok and (v / 1000) or 0
end

local velCache = {}
local function smoothedVelocity(part)
    local raw = part.AssemblyLinearVelocity
    if not Config.VelocitySmooth then return raw end
    local key = tostring(part)
    local now = os.clock()
    local c = velCache[key]
    if not c then c = {}; velCache[key] = c end
    table.insert(c, { v = raw, t = now })
    while #c > 0 and now - c[1].t > 0.1 do table.remove(c, 1) end
    local sum = Vector3.zero
    for _, e in ipairs(c) do sum = sum + e.v end
    return #c > 0 and (sum / #c) or Vector3.zero
end

local function predictedPosition(part)
    if not Config.PredictEnabled then return part.Position end
    local vel = smoothedVelocity(part)
    if vel.Magnitude < 0.05 then return part.Position end
    local offset = Vector3.new(
        vel.X * Config.PredictXZ,
        vel.Y * Config.PredictY,
        vel.Z * Config.PredictXZ
    )
    if Config.PingComp then
        offset = offset + vel * (getPingSeconds() * 0.5)
    end
    return part.Position + offset
end

-- ===================== V2-CACHE =====================
local murdererCache = nil
local cacheTicks = 0

-- [1] Синхронный поиск — вызывается ТОЛЬКО из фонового цикла
local function findMurdererOnce()
    if game.PlaceId == 142823291 then
        local ok, data = pcall(function()
            local rf = RS:FindFirstChild("GetPlayerData", true)
            if rf and rf:IsA("RemoteFunction") then
                return rf:InvokeServer()
            end
        end)
        if ok and type(data) == "table" then
            for name, info in pairs(data) do
                if type(info) == "table"
                    and tostring(info.Role or ""):lower() == "murderer"
                    and not info.Killed and not info.Dead
                then
                    local p = Players:FindFirstChild(name)
                    if p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        return p
                    end
                end
            end
        end
        return nil
    end
    -- Fallback: детект ножа в инвентаре
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                for _, c in ipairs(p.Character:GetChildren()) do
                    if c:IsA("Tool") and c.Name == "Knife" then return p end
                end
                local bp = p:FindFirstChild("Backpack")
                if bp and bp:FindFirstChild("Knife") then return p end
            end
        end
    end
    return nil
end

local function startCacheLoop()
    if getgenv()._flickV2CacheRunning then return end
    getgenv()._flickV2CacheRunning = true
    task.spawn(function()
        while getgenv()._flickV2CacheRunning do
            local ok, res = pcall(findMurdererOnce)
            murdererCache = ok and res or nil
            cacheTicks = cacheTicks + 1
            task.wait(Config.CacheInterval)
        end
    end)
end

-- ===================== V2-GUN =====================
local function findGunEquipped()
    local char = LP.Character
    if not char then return nil end
    for _, c in ipairs(char:GetChildren()) do
        if c:IsA("Tool") and c.Name == "Gun" then return c end
    end
    return nil
end

local function findGunAnywhere()
    local eq = findGunEquipped()
    if eq then return eq end
    local bp = LP:FindFirstChild("Backpack")
    if bp then
        local g = bp:FindFirstChild("Gun")
        if g and g:IsA("Tool") then return g end
    end
    return nil
end

local function equipGunIfNeeded()
    if findGunEquipped() then return true end
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    local bp = LP:FindFirstChild("Backpack")
    local g = bp and bp:FindFirstChild("Gun")
    if not (g and g:IsA("Tool")) then return false end
    pcall(function() hum:EquipTool(g) end)
    task.wait(0.08)
    return findGunEquipped() ~= nil
end

local function unequipGun()
    local gun = findGunEquipped()
    if not gun then return end
    local bp = LP:FindFirstChild("Backpack")
    if bp then pcall(function() gun.Parent = bp end) end
end

-- ===================== V2-REMOTE =====================
-- [4] Ищем либо по стандартному пути, либо рекурсивно по имени "shoot"
local shootRemote = nil

local function resolveShootRemote()
    if shootRemote and shootRemote.Parent then return shootRemote end

    local remotes = RS:FindFirstChild("Remotes")
    if remotes then
        local gun = remotes:FindFirstChild("Gun")
        if gun then
            local s = gun:FindFirstChild("Shoot")
            if s and s:IsA("RemoteEvent") then
                shootRemote = s
                return s
            end
        end
    end

    local ok, result = pcall(function()
        for _, d in ipairs(RS:GetDescendants()) do
            if d:IsA("RemoteEvent") and string.find(string.lower(d.Name), "shoot") then
                return d
            end
        end
    end)
    if ok and result then
        shootRemote = result
        return result
    end

    return nil
end

-- [3] Двойной pcall: сначала (pos, camCF), затем (pos)
local function fireShoot(remote, targetPos, camCF)
    if not remote then return false, "no_remote" end

    local ok1 = pcall(function()
        remote:FireServer(targetPos, camCF)
    end)
    if ok1 then return true, "pos+camCF" end

    local ok2 = pcall(function()
        remote:FireServer(targetPos)
    end)
    if ok2 then return true, "pos" end

    return false, "fire_failed"
end

-- ===================== V2-WALL =====================
-- [6] Raycast от головы до таргета. Если что-то (кроме своей/целевой модели) на пути — стена
local function hasLineOfSight(targetPos)
    local char = LP.Character
    if not char then return false end
    local origin = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    if not origin then return false end

    local filter = { char }
    if murdererCache and murdererCache.Character then
        table.insert(filter, murdererCache.Character)
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = filter
    params.IgnoreWater = true

    local dir = targetPos - origin.Position
    local hit = workspace:Raycast(origin.Position, dir, params)
    return hit == nil
end

-- ===================== V2-FLICK =====================
local firing = false
local lastFlickAt = 0   -- [2]

-- [5][8] AutoRotate восстанавливается в pcall на любом пути, тело крутится в pcall
local function visualBodyFlick(targetPos, instant)
    local char = LP.Character
    if not char then return end
    local hum  = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return end

    local wasAuto = hum.AutoRotate

    pcall(function()
        hum.AutoRotate = false

        local flatTarget = Vector3.new(targetPos.X, root.Position.Y, targetPos.Z)
        if (flatTarget - root.Position).Magnitude < 0.5 then return end

        local targetCFrame = CFrame.lookAt(root.Position, flatTarget)

        if instant then
            root.CFrame = targetCFrame
            RunService.Heartbeat:Wait()
        else
            local origCFrame = root.CFrame
            local angle = math.acos(math.clamp(
                origCFrame.LookVector:Dot(targetCFrame.LookVector), -1, 1))
            local totalTime = math.clamp(
                angle / (math.max(Config.FlickSpeed, 1) * 2), 0.02, 0.4)
            local steps = math.clamp(math.floor(totalTime * 60), 4, 30)
            for i = 1, steps do
                root.CFrame = origCFrame:Lerp(targetCFrame, i / steps)
                RunService.RenderStepped:Wait()
            end
        end
    end)

    pcall(function() hum.AutoRotate = wasAuto end)
end

local function computeCameraCFrame(targetPos)
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    return CFrame.lookAt(cam.CFrame.Position, targetPos)
end

local function flick()
    if not Config.Enabled then
        notify("Flick disabled.", 1)
        return
    end

    -- [2] rate-limit
    local now = os.clock()
    if now - lastFlickAt < Config.FlickCooldown then return end
    lastFlickAt = now

    if firing then return end
    firing = true

    -- [1] Никакого InvokeServer здесь — только чтение кэша
    local murderer = murdererCache
    if not murderer or not murderer.Parent or not murderer.Character then
        notify("No cached murderer", 1)
        firing = false
        return
    end

    local tRoot = murderer.Character:FindFirstChild("HumanoidRootPart")
    local tHum  = murderer.Character:FindFirstChildOfClass("Humanoid")
    if not tRoot or not tHum or tHum.Health <= 0 then
        notify("Murderer unavailable.", 1)
        firing = false
        return
    end

    local targetPos = predictedPosition(tRoot)

    -- [6] wall check
    if Config.WallCheck and not hasLineOfSight(targetPos) then
        notify("Wall between you and target.", 1)
        firing = false
        return
    end

    local camCF = computeCameraCFrame(targetPos)
    if not camCF then firing = false; return end

    if Config.AutoShoot then
        if not findGunAnywhere() then
            notify("No Gun in inventory.", 1)
            firing = false
            return
        end
        if not equipGunIfNeeded() then
            notify("Equip failed.", 1)
            firing = false
            return
        end

        local remote = resolveShootRemote()
        if not remote then
            notify("Shoot remote not found.", 1)
            firing = false
            return
        end

        local sent = fireShoot(remote, targetPos, camCF)
        if not sent then
            -- no-op: server rejected/errored, не спамим
        end

        if Config.AutoUnequip then unequipGun() end
    end

    task.spawn(function()
        visualBodyFlick(targetPos, Config.InstantFlick)
        firing = false
    end)
end

