local function getPing()
    local ok, p = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
    return ok and (p / 1000) or 0
end

local velocityCache = {}
local function getSmoothedVelocity(part)
    if not Config.VelocitySmooth then return part.AssemblyLinearVelocity end
    local now = tick()
    local key = tostring(part)
    if not velocityCache[key] then velocityCache[key] = {} end
    local cache = velocityCache[key]
    table.insert(cache, {v = part.AssemblyLinearVelocity, t = now})
    while #cache > 0 and now - cache[1].t > 0.1 do table.remove(cache, 1) end
    local avg = Vector3.zero
    for _, e in ipairs(cache) do avg = avg + e.v end
    if #cache > 0 then avg = avg / #cache end
    return avg
end

local function getPredictedPosition(part)
    if not part or not Config.PredictEnabled then return part.Position end
    local vel = getSmoothedVelocity(part)
    if not vel then return part.Position end
    local mxz, my = Config.PredictXZ, part.Name == "HumanoidRootPart" and 0 or Config.PredictY
    if Config.PredictOp == "Divide" then
        if mxz > 0 then mxz = 1 / mxz else mxz = 0 end
        if my > 0 then my = 1 / my else my = 0 end
    end
    local offset = Vector3.new(vel.X * mxz, vel.Y * my, vel.Z * mxz)
    if Config.PingComp then
        local po = vel * (getPing() * 0.5)
        if part.Name == "HumanoidRootPart" then po = Vector3.new(po.X, 0, po.Z) end
        offset = offset + po
    end
    return part.Position + offset
end

local function getAngularDelta(cam, targetPos)
    local camPos = cam.CFrame.Position
    local delta = targetPos - camPos
    if delta.Magnitude < 0.1 then return 0, 0 end
    local localDir = cam.CFrame:VectorToObjectSpace(delta.Unit)
    local yaw = math.atan2(localDir.X, -localDir.Z)
    local pitch = math.atan2(localDir.Y, math.sqrt(localDir.X * localDir.X + localDir.Z * localDir.Z))
    return yaw, pitch
end

local function findShootRemote()
    local wsPlayer = workspace:FindFirstChild(LocalPlayer.Name)
    if wsPlayer then
        local gun = wsPlayer:FindFirstChild("Gun")
        if gun then
            local shoot = gun:FindFirstChild("Shoot")
            if shoot and shoot:IsA("RemoteEvent") then return shoot end
        end
    end
    return nil
end

local function getGunPosition()
    local wsPlayer = workspace:FindFirstChild(LocalPlayer.Name)
    if wsPlayer then
        local gun = wsPlayer:FindFirstChild("Gun")
        if gun then
            local handle = gun:FindFirstChild("Handle")
            if handle and handle:IsA("BasePart") then return handle.Position end
            if gun:IsA("BasePart") then return gun.Position end
            for _, v in ipairs(gun:GetDescendants()) do
                if v:IsA("BasePart") then return v.Position end
            end
        end
    end
    return nil
end

local function equipGun()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local gun = char and char:FindFirstChild("Gun") or (bp and bp:FindFirstChild("Gun"))
    if gun and hum and gun.Parent ~= char then
        hum:EquipTool(gun)
        local deadline = os.clock() + Config.EquipTimeout
        while not workspace:FindFirstChild(LocalPlayer.Name) and os.clock() < deadline do
            RunService.Heartbeat:Wait()
        end
        task.wait(0.1)
    end
end

local function smoothReturn(accumX, accumY)
    if not Config.ReturnCamera then return end
    if accumX == 0 and accumY == 0 then return end

    local baseDelay = Config.ReturnDelay + math.random(0, Config.ReturnRandomDelayMs)
    if baseDelay > 0 then
        task.wait(baseDelay / 1000)
    end

    local steps = math.max(3, math.floor(Config.ReturnSpeed))
    local stepX = accumX / steps
    local stepY = accumY / steps

    for i = 1, steps do
        if not getgenv().FlickRunning then break end
        local mx, my = -stepX, -stepY
        if i == steps then
            mx = mx + (math.random() * 2 - 1) * Config.ReturnRandomPx
            my = my + (math.random() * 2 - 1) * Config.ReturnRandomPx
        end
        mousemoverel(mx, my)
        task.wait()
    end
end

local isFlicking = false

local function aimLoop(getTargetPos)
    local cam = workspace.CurrentCamera
    local accumX, accumY = 0, 0
    local lastPos = nil
    local converged = false
    local tolerance = math.rad(Config.AimToleranceDeg)
    local baseStep = math.clamp(Config.AimSpeed, 0.05, 1.0)
    local maxIterations = math.floor(Config.AimMaxTime * 60)
    local boostEvery = 30
    local stableFrames = 0
    local requiredStable = math.max(1, math.floor(Config.AimStableFrames))

    for i = 1, maxIterations do
        if not getgenv().FlickRunning then break end

        local targetPos = getTargetPos()
        if not targetPos then break end
        lastPos = targetPos

        local yaw, pitch = getAngularDelta(cam, targetPos)
        local angle = math.sqrt(yaw * yaw + pitch * pitch)

        if angle < tolerance then
            stableFrames = stableFrames + 1
            if stableFrames >= requiredStable then
                local verifyPos = getTargetPos()
                if verifyPos then
                    local vy, vp = getAngularDelta(cam, verifyPos)
                    local vAngle = math.sqrt(vy * vy + vp * vp)
                    if vAngle < tolerance then
                        lastPos = verifyPos
                        converged = true
                        break
                    end
                    stableFrames = 0
                else
                    converged = true
                    break
                end
            end
        else
            stableFrames = 0
        end

        local boost = 1 + math.floor((i - 1) / boostEvery) * 0.5
        local stepFrac = math.min(baseStep * boost, 1.0)

        local dx = yaw * sensitivityPxPerRad * stepFrac
        local dy = -pitch * sensitivityPxPerRad * stepFrac

        local mag = math.sqrt(dx * dx + dy * dy)
        if mag > Config.AimMaxPixels then
            local k = Config.AimMaxPixels / mag
            dx, dy = dx * k, dy * k
        end

        mousemoverel(dx, dy)
        accumX = accumX + dx
        accumY = accumY + dy
        task.wait()
    end

    return accumX, accumY, lastPos, converged
end

function flickToMurderer()
    if not Config.Enabled or isFlicking then return end
    isFlicking = true

    local murderer = cachedMurderer or findMurderer()
    if not murderer then notify("No target") isFlicking = false return end

    local cam = workspace.CurrentCamera
    local char = LocalPlayer.Character
    if not char then isFlicking = false return end

    local function getTargetPos()
        if not murderer or not murderer.Character then return nil end
        local hum = murderer.Character:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return nil end
        local tp = murderer.Character:FindFirstChild(Config.TargetPart) or murderer.Character:FindFirstChild("HumanoidRootPart")
        if not tp then return nil end
        return getPredictedPosition(tp)
    end

    local initialPos = getTargetPos()
    if not initialPos then notify("No target pos") isFlicking = false return end

    if Config.WallCheck then
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {char, murderer.Character}
        local ray = workspace:Raycast(cam.CFrame.Position, initialPos - cam.CFrame.Position, params)
        if ray then notify("Wall blocked") isFlicking = false return end
    end

    equipGun()
    local remote = findShootRemote()
    if not remote then notify("No remote") isFlicking = false return end

    if Config.SilentAim then
        local aimCFrame
        if Config.BulletFromGun then
            local gunPos = getGunPosition()
            aimCFrame = gunPos and CFrame.lookAt(gunPos, initialPos) or CFrame.lookAt(cam.CFrame.Position, initialPos)
        else
            aimCFrame = CFrame.lookAt(cam.CFrame.Position, initialPos)
        end
        pcall(function() remote:FireServer(aimCFrame, CFrame.new(initialPos)) end)
        notify("Silent fired")
        isFlicking = false
        return
    end

    measureSensitivity()
    local accumX, accumY, finalPos, converged = aimLoop(getTargetPos)

    if not converged then
        smoothReturn(accumX, accumY)
        isFlicking = false
        return
    end

    local freshPos = getTargetPos()
    if freshPos then finalPos = freshPos end
    if not finalPos then
        smoothReturn(accumX, accumY)
        isFlicking = false
        return
    end

    local shootCFrame
    if Config.BulletFromGun then
        local gunPos = getGunPosition()
        shootCFrame = gunPos and CFrame.lookAt(gunPos, finalPos) or CFrame.lookAt(cam.CFrame.Position, finalPos)
    else
        shootCFrame = CFrame.lookAt(cam.CFrame.Position, finalPos)
    end
    pcall(function() remote:FireServer(shootCFrame, CFrame.new(finalPos)) end)

    smoothReturn(accumX, accumY)
    notify("Fired")
    isFlicking = false
end

local waitingForBind = false
