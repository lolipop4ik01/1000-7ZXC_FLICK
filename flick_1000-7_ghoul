    title.Size = UDim2.new(1, -110, 1, 0)
    title.Position = UDim2.new(0, 14, 0, 0)
    title.BackgroundTransparency = 1
    title.Text = "⚡ FLICK MM2"
    title.TextColor3 = Theme.accent
    title.Font = Enum.Font.GothamBold
    title.TextSize = 15
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = header

    local ver = Instance.new("TextLabel")
    ver.Size = UDim2.new(0, 60, 1, 0)
    ver.Position = UDim2.new(1, -76, 0, 0)
    ver.BackgroundTransparency = 1
    ver.Text = "v" .. (V4.Version and V4.Version.script or "4.0.0")
    ver.TextColor3 = Theme.textDim
    ver.Font = Enum.Font.Gotham
    ver.TextSize = 11
    ver.TextXAlignment = Enum.TextXAlignment.Right
    ver.Parent = header

    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0, 28, 0, 28)
    closeBtn.Position = UDim2.new(1, -36, 0.5, -14)
    closeBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
    closeBtn.BorderSizePixel = 0
    closeBtn.Text = "✕"
    closeBtn.TextColor3 = Theme.text
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.TextSize = 13
    closeBtn.Parent = header
    Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0, 6)
    Track(closeBtn.MouseButton1Click:Connect(function()
        frame.Visible = false
    end))

    -- ---------- SCROLL ----------
    local scroll = Instance.new("ScrollingFrame")
    scroll.Name = "Scroll"
    scroll.Size = UDim2.new(1, -16, 1, -56)
    scroll.Position = UDim2.new(0, 8, 0, 50)
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel = 0
    scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    scroll.ScrollBarThickness = 3
    scroll.ScrollBarImageColor3 = Color3.fromRGB(70, 70, 80)
    scroll.Parent = frame

    local layout = Instance.new("UIListLayout", scroll)
    layout.Padding = UDim.new(0, 6)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    Track(layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 8)
