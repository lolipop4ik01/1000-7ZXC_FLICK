    frame.Size = UDim2.new(0, 320, 0, 620); frame.Position = UDim2.new(0.5, -160, 0.5, -310)
    frame.BackgroundColor3 = Theme.bg; frame.BorderSizePixel = 0; frame.Visible = false; frame.Active = true
    frame.Parent = gui
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 12)

    local header = Instance.new("Frame")
    header.Size = UDim2.new(1, 0, 0, 44); header.BackgroundColor3 = Theme.panel; header.BorderSizePixel = 0; header.Parent = frame
    Instance.new("UICorner", header).CornerRadius = UDim.new(0, 12)
    makeDraggable(frame, header)

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -110, 1, 0); title.Position = UDim2.new(0, 14, 0, 0)
    title.BackgroundTransparency = 1; title.Text = "⚡ FLICK MM2"; title.TextColor3 = Theme.accent
    title.Font = Enum.Font.GothamBold; title.TextSize = 15; title.TextXAlignment = Enum.TextXAlignment.Left; title.Parent = header

    local ver = Instance.new("TextLabel")
    ver.Size = UDim2.new(0, 60, 1, 0); ver.Position = UDim2.new(1, -76, 0, 0)
    ver.BackgroundTransparency = 1; ver.Text = "v" .. SCRIPT_VERSION; ver.TextColor3 = Theme.textDim
    ver.Font = Enum.Font.Gotham; ver.TextSize = 11; ver.TextXAlignment = Enum.TextXAlignment.Right; ver.Parent = header

    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0, 28, 0, 28); closeBtn.Position = UDim2.new(1, -36, 0.5, -14)
    closeBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 48); closeBtn.BorderSizePixel = 0
    closeBtn.Text = "✕"; closeBtn.TextColor3 = Theme.text; closeBtn.Font = Enum.Font.GothamBold; closeBtn.TextSize = 13
    closeBtn.Parent = header; Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0, 6)
    track(closeBtn.MouseButton1Click:Connect(function() frame.Visible = false end))

    local scroll = Instance.new("ScrollingFrame")
    scroll.Size = UDim2.new(1, -16, 1, -56); scroll.Position = UDim2.new(0, 8, 0, 50)
    scroll.BackgroundTransparency = 1; scroll.BorderSizePixel = 0; scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    scroll.ScrollBarThickness = 3; scroll.ScrollBarImageColor3 = Color3.fromRGB(70, 70, 80); scroll.Parent = frame

    local layout = Instance.new("UIListLayout", scroll)
    layout.Padding = UDim.new(0, 6); layout.SortOrder = Enum.SortOrder.LayoutOrder
    track(layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 8)
    end))

    W.section(scroll, "CORE")
    W.toggle(scroll, "Enable Flick",  "Enabled")
    W.toggle(scroll, "Instant Flick", "InstantFlick")
    W.slider(scroll, "Flick Speed", "FlickSpeed", 1, 240, false, 1)
    W.slider(scroll, "Flick Cooldown (s)", "FlickCooldown", 0.05, 1.0, true, 0.01)

    W.section(scroll, "SHOOT")
    W.toggle(scroll, "Auto Shoot", "AutoShoot")
    W.toggle(scroll, "Auto Unequip", "AutoUnequip")
    W.toggle(scroll, "Wall Check", "WallCheck")
    W.slider(scroll, "Equip Timeout (s)", "EquipTimeout", 0.3, 3.0, true, 0.1)

    W.section(scroll, "AIM PREDICT")
    W.toggle(scroll, "Predict", "PredictEnabled")
    W.toggle(scroll, "Ping Comp", "PingComp")
    W.slider(scroll, "Predict X/Z", "PredictXZ", 0.0, 0.5, true, 0.001)
    W.slider(scroll, "Predict Y", "PredictY", 0.0, 0.2, true, 0.001)

    W.section(scroll, "DIAGNOSTICS")
    W.toggle(scroll, "Diagnostic Mode (Print to F9)", "DiagnosticMode")
    W.toggle(scroll, "Debug Hook (Re-enable logs)", "DebugHook")
    W.button(scroll, "🔍 Test Connections (F9)", function() 
        print("=== DIAGNOSTIC ===")
        print("Murderer Cache: " .. tostring(murdererCache and murdererCache.Name))
        print("Gun in Backpack: " .. tostring(findGunAnywhere() ~= nil))
        print("Remote found: " .. tostring(resolveShootRemote() ~= nil))
        print("==================")
    end, Color3.fromRGB(60, 60, 60))

    W.section(scroll, "ACTIONS")
    W.button(scroll, "🎯 FLICK NOW", function() task.spawn(flick) end, Color3.fromRGB(60, 80, 60))

    local bindBtn = W.button(scroll, "⌨️ BIND: " .. Config.Keybind, function()
        bindBtn.Text = "⌨️ PRESS A KEY..."
        startBind()
    end, Color3.fromRGB(55, 50, 40))

    getgenv()._flickV8 = {
        UpdateBindUI = function(newKey)
            if bindBtn and bindBtn.Parent then bindBtn.Text = "⌨️ BIND: " .. newKey end
        end
    }

    local cacheLabel = Instance.new("TextLabel")
    cacheLabel.Size = UDim2.new(1, 0, 0, 22); cacheLabel.BackgroundTransparency = 1
    cacheLabel.Text = "cache: —"; cacheLabel.TextColor3 = Theme.textDim
    cacheLabel.Font = Enum.Font.Gotham; cacheLabel.TextSize = 11; cacheLabel.TextXAlignment = Enum.TextXAlignment.Left; cacheLabel.Parent = scroll

    task.spawn(function()
        while cacheLabel and cacheLabel.Parent do
            cacheLabel.Text = string.format("cache: %s (ticks=%d)", murdererCache and murdererCache.Name or "nil", cacheTicks)
            task.wait(1)
        end
    end)

    W.button(scroll, "💀 Unload", function()
        pcall(disconnectAll); pcall(function() gui:Destroy() end)
    end, Theme.danger)

    track(circle.MouseButton1Click:Connect(function() frame.Visible = not frame.Visible end))
end

