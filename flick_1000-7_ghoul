-- ===================== V5-PREDICT =====================
local function getPingSeconds()
    local ok, v = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    return ok and (v / 1000) or 0
end

local velCache = {}
local function smoothedVelocity(part)
    local raw = part.AssemblyLinearVelocity
    if not Config.VelocitySmooth then return raw end
    local key = tostring(part)
    local now = os.clock()
    local c = velCache[key]
    if not c then c = {}; velCache[key] = c end
    table.insert(c, { v = raw, t = now, part = part })
    while #c > 0 and now - c[1].t > 0.1 do table.remove(c, 1) end
    local sum = Vector3.zero
    for _, e in ipairs(c) do sum = sum + e.v end
    return #c > 0 and (sum / #c) or Vector3.zero
end

-- Чистка velCache от мёртвых партов
task.spawn(function()
    while isCurrentInstance() do
        task.wait(10)
        for key, entries in pairs(velCache) do
            if #entries == 0 then
                velCache[key] = nil
            else
                local last = entries[#entries]
                if not last.part or not last.part.Parent then
                    velCache[key] = nil
                end
            end
        end
    end
end)

local function predictedPosition(part)
    if not Config.PredictEnabled then return part.Position end
    local vel = smoothedVelocity(part)
    if vel.Magnitude < 0.05 then return part.Position end
    local offset = Vector3.new(
        vel.X * Config.PredictXZ,
        vel.Y * Config.PredictY,
        vel.Z * Config.PredictXZ
    )
    if Config.PingComp then
        offset = offset + vel * (getPingSeconds() * 0.5)
    end
    return part.Position + offset
end

-- ===================== V5-CACHE =====================
local murdererCache = nil
local cacheTicks    = 0

-- [4] Универсальный resolve ключа: string / number(UserId) / Instance
local function resolvePlayerByKey(key)
    if type(key) == "string" then
        return Players:FindFirstChild(key)
    end
    if type(key) == "number" then
        return Players:GetPlayerByUserId(key)
    end
    if typeof(key) == "Instance" then
        if key:IsA("Player") then return key end
        -- на случай, если пришёл Character
        if key:IsA("Model") then
            return Players:GetPlayerFromCharacter(key)
        end
    end
    return nil
end

local function isMurdererRole(role)
    if role == nil then return false end
    local s = tostring(role):lower()
    return s == "murderer" or s == "1"
end

-- data: [playerRef] = {Role=..., Killed=..., Dead=..., ...}
-- где playerRef может быть userId, именем или Player
local function parseMurdererFromData(data)
    if type(data) ~= "table" then return nil end

    for key, info in pairs(data) do
        local role, killed, dead = nil, false, false

        if type(info) == "table" then
            role   = info.Role or info.role or info.RoleId or info.roleId
            killed = info.Killed or info.killed or false
            dead   = info.Dead   or info.dead   or false
        elseif type(info) == "string" or type(info) == "number" then
            role = info   -- вариант: data[userId] = "Murderer"
        end

        if isMurdererRole(role) and not killed and not dead then
            local playerObj = resolvePlayerByKey(key)

            -- фоллбеки внутри info
            if not playerObj and type(info) == "table" then
                if typeof(info.Player) == "Instance" and info.Player:IsA("Player") then
                    playerObj = info.Player
                elseif type(info.UserId) == "number" then
                    playerObj = Players:GetPlayerByUserId(info.UserId)
                elseif type(info.userId) == "number" then
                    playerObj = Players:GetPlayerByUserId(info.userId)
                end
            end

            if playerObj and playerObj.Character
                and playerObj.Character:FindFirstChild("HumanoidRootPart") then
                return playerObj
            end
        end
    end
    return nil
end

local function findMurdererOnce()
    if game.PlaceId == 142823291 then
        local ok, data = pcall(function()
            local rf = RS:FindFirstChild("GetPlayerData", true)
            if rf and rf:IsA("RemoteFunction") then
                return rf:InvokeServer()
            end
        end)
        if ok and data then
            local found = parseMurdererFromData(data)
            if found then return found end
        end
        return nil
    end
    -- fallback: нож в character/backpack
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                for _, c in ipairs(p.Character:GetChildren()) do
                    if c:IsA("Tool") and c.Name == "Knife" then return p end
                end
                local bp = p:FindFirstChild("Backpack")
                if bp and bp:FindFirstChild("Knife") then return p end
            end
        end
    end
    return nil
end

local function startCacheLoop()
    task.spawn(function()
        while isCurrentInstance() do
            local ok, res = pcall(findMurdererOnce)
            if not isCurrentInstance() then break end
            murdererCache = ok and res or nil
            cacheTicks = cacheTicks + 1
            task.wait(Config.CacheInterval)
        end
    end)
end

-- ===================== V5-GUN =====================
local function findGunEquipped()
    local char = LP.Character
    if not char then return nil end
    for _, c in ipairs(char:GetChildren()) do
        if c:IsA("Tool") and c.Name == "Gun" then return c end
    end
    return nil
end

local function findGunAnywhere()
    local eq = findGunEquipped()
    if eq then return eq end
    local bp = LP:FindFirstChild("Backpack")
    if bp then
        local g = bp:FindFirstChild("Gun")
        if g and g:IsA("Tool") then return g end
    end
    return nil
end

local function unequipGun()
    local gun = findGunEquipped()
    if not gun then return end
    local bp = LP:FindFirstChild("Backpack")
    if bp then pcall(function() gun.Parent = bp end) end
end

local function equipGunIfNeeded()
    if findGunEquipped() then return true end

    local char = LP.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end

    local bp = LP:FindFirstChild("Backpack")
    local g  = bp and bp:FindFirstChild("Gun")
    if not (g and g:IsA("Tool")) then return false end

    local arrived = false
    local conn
    conn = char.ChildAdded:Connect(function(c)
        if c == g then arrived = true end
    end)

    pcall(function() hum:EquipTool(g) end)

    local deadline = os.clock() + Config.EquipTimeout
    while not arrived and os.clock() < deadline and isCurrentInstance() do
        RunService.Heartbeat:Wait()
    end

    if conn then conn:Disconnect() end
    return findGunEquipped() ~= nil
end

-- ===================== V5-REMOTE =====================
local shootRemote = nil

local function resolveShootRemote()
    if shootRemote and shootRemote.Parent then return shootRemote end

    local remotes = RS:FindFirstChild("Remotes")
    if remotes then
        local gun = remotes:FindFirstChild("Gun")
        if gun then
            local s = gun:FindFirstChild("Shoot")
            if s and s:IsA("RemoteEvent") then
                shootRemote = s
                return s
            end
        end
    end

    local ok, result = pcall(function()
        for _, d in ipairs(RS:GetDescendants()) do
            if d:IsA("RemoteEvent") and d.Name == "Shoot" then
                local p = d.Parent
                if p and string.find(string.lower(p.Name), "gun") then
                    return d
                end
            end
        end
    end)
    if ok and result then
        shootRemote = result
        return result
    end

    local ok2, result2 = pcall(function()
        for _, d in ipairs(RS:GetDescendants()) do
            if d:IsA("RemoteEvent") and d.Name == "Shoot" then
                return d
            end
        end
    end)
    if ok2 and result2 then
        shootRemote = result2
        return result2
    end

    return nil
end

-- [6] Основной вызов. По F9-логам может быть (UserId, CFrame) или (Player, Vector3) —
-- уточняем через Debug Hook и Debug Shot (Часть 2).
local function fireShoot(targetPos, camCF)
    local remote = resolveShootRemote()
    if not remote then return false, "no_remote" end
    local ok = pcall(function()
        remote:FireServer(camCF, targetPos)
    end)
    return ok
end

-- ===================== V5-HOOK =====================
-- [3] Правильный хук через getrawmetatable + setreadonly
local hookInstalled = false

local function installFireServerHook()
    if hookInstalled then return end
    hookInstalled = true

    local hasGetRawMeta  = (type(getrawmetatable) == "function")
    local hasSetReadonly = (type(setreadonly)    == "function")
    local hasNewCClosure = (type(newcclosure)    == "function")
    local hasCheckCaller = (type(checkcaller)    == "function")
    local hasGetNamecall = (type(getnamecallmethod) == "function")

    if not (hasGetRawMeta and hasSetReadonly and hasGetNamecall) then
        print("[FlickV5-HOOK] нет примитивов (getrawmetatable/setreadonly/getnamecallmethod). Хук пропущен.")
        return
    end

    local okMt, mt = pcall(getrawmetatable, game)
    if not okMt or type(mt) ~= "table" then
        print("[FlickV5-HOOK] getrawmetatable(game) вернул не таблицу.")
        return
    end

    local oldNamecall = mt.__namecall
    if type(oldNamecall) ~= "function" then
        print("[FlickV5-HOOK] mt.__namecall отсутствует.")
        return
    end

    local function logFireServer(self, ...)
        local method = getnamecallmethod()
        if method ~= "FireServer" then return end

        local isRemote = false
        pcall(function()
            isRemote = (typeof(self) == "Instance") and self:IsA("RemoteEvent")
        end)
        if not isRemote then return end

        if hasCheckCaller and checkcaller() then return end  -- не логируем себя

        local name   = self.Name
        local parent = self.Parent
        local pName  = parent and parent.Name or ""
        local pPath  = parent and parent:GetFullName() or "?"

        local isShoot = (string.lower(name) == "shoot")
            or string.find(string.lower(pName), "gun")
            or string.find(string.lower(pName), "shoot")

        if isShoot and Config.DebugHook then
            local args = table.pack(...)
            print(("[FlickV5-HOOK] FireServer → %s | nargs=%d")
                :format(pPath, args.n))
            for i = 1, args.n do
                local v = args[i]
                print(("  arg[%d] : %s = %s"):format(i, typeof(v), tostring(v)))
            end
        end
    end

    -- обёртка, которая зовёт оригинал
    local function wrapper(self, ...)
        logFireServer(self, ...)
        return oldNamecall(self, ...)
    end

    local wrapped = wrapper
    if hasNewCClosure then
        local okW, res = pcall(newcclosure, wrapper)
        if okW and type(res) == "function" then wrapped = res end
    end

    -- записываем в метатаблицу
    local okR = pcall(setreadonly, mt, false)
    if not okR then
        print("[FlickV5-HOOK] setreadonly(mt, false) упал.")
        return
    end

    mt.__namecall = wrapped

    pcall(setreadonly, mt, true)

    print("[FlickV5-HOOK] установлен. DebugHook=" .. tostring(Config.DebugHook))
    if not Config.DebugHook then
        print("[FlickV5-HOOK] Включи Debug Hook в GUI и выстрели вручную — получишь сигнатуру.")
    end
end

-- ===================== V5-WALL =====================
local function hasLineOfSight(targetPos)
    local char = LP.Character
    if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    local filter = { char }
    if murdererCache and murdererCache.Character then
        table.insert(filter, murdererCache.Character)
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = filter
    params.IgnoreWater = true

    local dir = targetPos - root.Position
    local hit = workspace:Raycast(root.Position, dir, params)
    return hit == nil
end

-- ===================== V5-FLICK =====================
local firing      = false
local lastFlickAt = 0

local function computeCameraCFrame(targetPos)
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    return CFrame.lookAt(cam.CFrame.Position, targetPos)
end

local function visualBodyFlick(targetPos, instant)
    local char = LP.Character
    if not char then return end
    local hum  = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return end

    local wasAuto = hum.AutoRotate

    pcall(function()
        hum.AutoRotate = false

        local flatTarget = Vector3.new(targetPos.X, root.Position.Y, targetPos.Z)
        if (flatTarget - root.Position).Magnitude < 0.5 then return end

        local targetCFrame = CFrame.lookAt(root.Position, flatTarget)

        if instant then
            root.CFrame = targetCFrame
            RunService.Heartbeat:Wait()
        else
            local origCFrame = root.CFrame
            local angle = math.acos(math.clamp(
                origCFrame.LookVector:Dot(targetCFrame.LookVector), -1, 1))
            local totalTime = math.clamp(
                angle / (math.max(Config.FlickSpeed, 1) * 2), 0.02, 0.4)
            local steps = math.clamp(math.floor(totalTime * 60), 4, 30)
            for i = 1, steps do
                if not isCurrentInstance() then break end
                root.CFrame = origCFrame:Lerp(targetCFrame, i / steps)
                RunService.RenderStepped:Wait()
            end
        end
    end)

    pcall(function() hum.AutoRotate = wasAuto end)
end

-- Просто вычисление параметров выстрела — используется flick() и Debug Shot в Части 2
local function computeShot()
    local murderer = murdererCache
    if not murderer or not murderer.Parent or not murderer.Character then
        return nil, "no_cached_murderer"
    end
    local tRoot = murderer.Character:FindFirstChild("HumanoidRootPart")
    local tHum  = murderer.Character:FindFirstChildOfClass("Humanoid")
    if not tRoot or not tHum or tHum.Health <= 0 then
        return nil, "murderer_unavailable"
    end
    local targetPos = predictedPosition(tRoot)
    if Config.WallCheck and not hasLineOfSight(targetPos) then
        return nil, "wall"
    end
    local camCF = computeCameraCFrame(targetPos)
    if not camCF then return nil, "no_camera" end
    return {
        murderer  = murderer,
        targetPos = targetPos,
        camCF     = camCF,
        remote    = resolveShootRemote(),
    }
end

local function flick()
    if not isCurrentInstance() then return end
    if not Config.Enabled then
        notify("Flick disabled.", 1)
        return
    end
    if firing then return end

    local now = os.clock()
    if now - lastFlickAt < Config.FlickCooldown then return end
    lastFlickAt = now

    firing = true

    local okRun, err = pcall(function()
        local shot, reason = computeShot()
        if not shot then
            if reason == "no_cached_murderer" then
                notify("No cached murderer", 1)
            elseif reason == "murderer_unavailable" then
                notify("Murderer unavailable.", 1)
            elseif reason == "wall" then
                notify("Wall between you and target.", 1)
            elseif reason == "no_camera" then
                -- тихо
            end
            return
        end

        -- Сначала визуальный поворот, потом выстрел
        visualBodyFlick(shot.targetPos, Config.InstantFlick)

        if not Config.AutoShoot then return end
        if not findGunAnywhere() then
            notify("No Gun in inventory.", 1)
            return
        end
        if not equipGunIfNeeded() then
            notify("Equip timeout.", 1)
            return
        end
        if not shot.remote then
            notify("Shoot remote not found.", 1)
            return
        end

        local okFire = fireShoot(shot.targetPos, shot.camCF)
        if not okFire then
            notify("Fire failed.", 1)
        end

        if Config.AutoUnequip then unequipGun() end
    end)

    firing = false
    if not okRun and err then
        warn("[FlickV5] flick error: " .. tostring(err))
    end
end

-- ===================== V5-KEYBIND =====================
local waitingForBind = false
local keyConn = nil

local function setupKeybind()
    if keyConn then keyConn:Disconnect() end
    keyConn = UIS.InputBegan:Connect(function(input, processed)
        -- [1] Сначала bind-режим — даже если processed=true
        if waitingForBind then
            waitingForBind = false
            if input.KeyCode ~= Enum.KeyCode.Unknown then
                Config.Keybind = input.KeyCode.Name
                saveConfig()
                notify("Keybind set: " .. Config.Keybind, 1)
            end
            return
        end

        if processed then return end
        if input.KeyCode == Enum.KeyCode[Config.Keybind] then
            task.spawn(flick)
        end
    end)
    track(keyConn)
end

local function startBind()
    waitingForBind = true
    notify("Press a key to bind...", 3)
    task.delay(3, function()
        if waitingForBind then
            waitingForBind = false
            notify("Bind cancelled.", 1)
        end
    end)
end

