local function updateVisualizer()
    if not Config.ShowPredictVisual then
        if visualPart then visualPart.Transparency = 1 end; if visualBeam then visualBeam.Enabled = false end; return
    end
    local murderer = findMurderer()
    if not murderer or not murderer.Character then
        if visualPart then visualPart.Transparency = 1 end; if visualBeam then visualBeam.Enabled = false end; return
    end
    local targetPart = murderer.Character:FindFirstChild(Config.TargetPart) or murderer.Character:FindFirstChild("HumanoidRootPart")
    if not targetPart then
        if visualPart then visualPart.Transparency = 1 end; if visualBeam then visualBeam.Enabled = false end; return
