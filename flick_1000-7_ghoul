-- ========== ЛОГИКА FLICK ==========
local lastCameraCFrame = nil
local waitingForLMB = false
local BODY_PARTS = {"Head", "HumanoidRootPart", "UpperTorso", "LowerTorso", "LeftArm", "RightArm", "LeftLeg", "RightLeg"}

local function getRandomBodyPart(character)
    local availableParts = {}
    for _, partName in ipairs(BODY_PARTS) do
        local part = character:FindFirstChild(partName)
        if part and part:IsA("BasePart") then table.insert(availableParts, part) end
    end
    if #availableParts > 0 then 
        return getPredictedPosition(availableParts[math.random(1, #availableParts)])
    end
    local root = character:FindFirstChild("HumanoidRootPart")
    return root and getPredictedPosition(root) or nil
end

local function findMurderer()
    if game.PlaceId == 142823291 then
        local success, roleData = pcall(function()
            local remote = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
            if remote and remote:IsA("RemoteFunction") then return remote:InvokeServer() end
        end)
        if success and roleData then
            for playerName, data in pairs(roleData) do
                if data.Role == "Murderer" and not data.Killed and not data.Dead then
                    local p = Players:FindFirstChild(playerName)
                    if p then return p end
                end
            end
        end
        return nil
    else
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local char = player.Character
                local root = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChild("Humanoid")
                if root and hum and hum.Health > 0 then
                    if player:FindFirstChild("Backpack") and player.Backpack:FindFirstChild("Knife") then return player end
                    for _, tool in ipairs(char:GetChildren()) do
                        if tool:IsA("Tool") and tool.Name == "Knife" then return player end
                    end
                end
            end
        end
        return nil
    end
end

local function findShootRemote()
    local ns = ReplicatedStorage:FindFirstChild("Axioria Solver was here.")
    if not ns then return nil end
    for _, v in ipairs(ns:GetChildren()) do
        if v:IsA("RemoteEvent") then return v end
    end
    return nil
end

local function autoShoot(murderer)
    if not Config.AutoShoot then return end
    if not murderer or not murderer.Character then return end
    local remote = findShootRemote()
    if not remote then return end
    
    -- Пересчитываем прямо перед выстрелом
    local targetPos
    if Config.RandomBodyPart then
        targetPos = getRandomBodyPart(murderer.Character)
    else
        local root = murderer.Character:FindFirstChild("HumanoidRootPart")
        if root then targetPos = getPredictedPosition(root) end
    end
    if not targetPos then return end
    
    pcall(function() remote:FireServer({ workspace.CurrentCamera.CFrame, CFrame.new(targetPos) }) end)
end

local function returnCameraWithRandomness()
    if not Config.ReturnCamera or not lastCameraCFrame then return end
    local cam = workspace.CurrentCamera
    local randomX = (math.random() - 0.5) * 2 * (Config.ReturnRandomnessX / 100)
    local randomY = (math.random() - 0.5) * 2 * (Config.ReturnRandomnessY / 100)
    local newLook = (lastCameraCFrame.LookVector + lastCameraCFrame.RightVector * randomX + lastCameraCFrame.UpVector * randomY).Unit
    local targetCFrame = CFrame.lookAt(lastCameraCFrame.Position, lastCameraCFrame.Position + newLook)
    local oldCFrame = cam.CFrame
    local angleDist = math.acos(math.clamp(oldCFrame.LookVector:Dot(targetCFrame.LookVector), -1, 1))
    local totalTime = math.clamp(angleDist / (Config.ReturnSpeed * 2), 0.01, 0.35)
    local steps = math.clamp(math.floor(60 * totalTime), 8, 40)
    for i = 1, steps do
        cam.CFrame = oldCFrame:Lerp(targetCFrame, i / steps)
        task.wait(totalTime / steps)
    end
    lastCameraCFrame = nil
end

function flickToMurderer()
    if not Config.Enabled then notify("Flick is disabled!", 1) return end
    local murderer = findMurderer()
    if not murderer then notify("Murderer not found!", 1) return end
    
    local cam, char = workspace.CurrentCamera, LocalPlayer.Character
    if not char then return end
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    if Config.ReturnCamera then lastCameraCFrame = cam.CFrame end
    
    local targetPos
    if Config.RandomBodyPart then
        targetPos = getRandomBodyPart(murderer.Character)
        if not targetPos then
            local mr = murderer.Character:FindFirstChild("HumanoidRootPart")
            if mr then targetPos = getPredictedPosition(mr) end
        end
    else
        local mr = murderer.Character:FindFirstChild("HumanoidRootPart")
        if mr then targetPos = getPredictedPosition(mr) end
    end
    
    if not targetPos then notify("Cannot get target position!", 1) return end
    
    local headPos = char:FindFirstChild("Head") and char.Head.Position or rootPart.Position
    local isFirstPerson = (cam.CFrame.Position - headPos).Magnitude < 5
    
    local newCFrame
    if isFirstPerson then
        newCFrame = CFrame.lookAt(cam.CFrame.Position, targetPos)
    else
        local distance = (cam.CFrame.Position - rootPart.Position).Magnitude
        newCFrame = CFrame.lookAt(rootPart.Position + (targetPos - rootPart.Position).Unit * distance, targetPos)
    end
    
    if Config.InstantFlick then
        cam.CFrame = newCFrame
    else
        local oldCFrame = cam.CFrame
        local angleDist = math.acos(math.clamp(oldCFrame.LookVector:Dot((targetPos - oldCFrame.Position).Unit), -1, 1))
        local totalTime = math.clamp(angleDist / (Config.FlickSpeed * 2), 0.01, 0.35)
        local steps = math.clamp(math.floor(60 * totalTime), 8, 40)
        for i = 1, steps do
            cam.CFrame = oldCFrame:Lerp(newCFrame, i / steps)
            task.wait(totalTime / steps)
        end
    end
    
    autoShoot(murderer)
    if Config.ReturnCamera then waitingForLMB = true end
end

-- ========== KEYBIND & LMB ==========
local waitingForBind = false
local function setupKeybind()
    if getgenv().KeybindConnection then pcall(function() getgenv().KeybindConnection:Disconnect() end) end
    getgenv().KeybindConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if waitingForBind then
            waitingForBind = false
            if input.KeyCode ~= Enum.KeyCode.Unknown then
                Config.Keybind = input.KeyCode.Name
                saveConfig()
                notify("Keybind set to: " .. Config.Keybind, 1)
                if BindButton and BindButton:FindFirstChild("TextLabel") then BindButton.TextLabel.Text = Config.Keybind end
            end
            return
        end
        if input.KeyCode == Enum.KeyCode[Config.Keybind] then flickToMurderer() end
    end)
end

if getgenv().LMBConnection then pcall(function() getgenv().LMBConnection:Disconnect() end) end
getgenv().LMBConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 and waitingForLMB and Config.ReturnCamera then
        waitingForLMB = false
        task.wait(Config.ReturnDelay / 1000)
        returnCameraWithRandomness()
    end
end)

