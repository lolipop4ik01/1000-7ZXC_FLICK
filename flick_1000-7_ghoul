-- ===================== [C1] HOOK __namecall =====================
-- Ставим хук на FireServer. Все вызовы на RemoteEvent с Name == "Shoot"
-- логируются: тип + repr каждого аргумента. Это единственный способ
-- узнать фактическую сигнатуру без серверного дампа.
-- Свой собственный вызов FireServer из флика проходит через этот же хук,
-- поэтому флаг internalCall подавляет лог для него, чтобы не спамить.

local internalFireGuard = false
local hookInstalled, hookErr = false, nil
local observedSignature  = nil   -- { types = {...}, count = n } после первого дампа

local function describeArg(a)
    local t = typeof(a)
    if t == "Instance" then
        return string.format("%s(%s)", t, a:GetFullName())
    elseif t == "Vector3" then
        return string.format("Vector3(%.2f, %.2f, %.2f)", a.X, a.Y, a.Z)
    elseif t == "CFrame" then
        local p = a.Position
        return string.format("CFrame(pos=%.2f,%.2f,%.2f)", p.X, p.Y, p.Z)
    end
    return string.format("%s(%s)", t, tostring(a))
end

local function installShootHook()
    local okHM, hookmm = pcall(function() return hookmetamethod end)
    local okGM, getmt  = pcall(function() return getrawmetatable end)
    local okRO, setro  = pcall(function() return setreadonly end)
    if not (okHM and hookmm and okGM and getmt and okRO and setro) then
        hookInstalled, hookErr = false, "executor_missing_hook_api"
        return false
    end

    local mt = getmt(game)
    if not mt or type(mt) ~= "table" then
        hookInstalled, hookErr = false, "no_game_metatable"
        return false
    end

    local oldNamecall = mt.__namecall
    if type(oldNamecall) ~= "function" then
        hookInstalled, hookErr = false, "no_namecall"
        return false
    end

    local okSet, err = pcall(function()
        setro(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()

            if method == "FireServer"
                and not internalFireGuard
                and not checkcaller()
                and typeof(self) == "Instance"
                and self:IsA("RemoteEvent")
                and self.Name == "Shoot"
            then
                local args = { ... }
                local types = {}
                for i = 1, #args do types[i] = typeof(args[i]) end

                if not observedSignature then
                    observedSignature = { types = types, count = #args }
                    print("[FlickV2][HOOK] === Shoot:FireServer observed ===")
                    print(string.format("[FlickV2][HOOK] argc=%d", #args))
                    for i, a in ipairs(args) do
                        print(string.format("[FlickV2][HOOK]   [%d] %s", i, describeArg(a)))
                    end
                    print("[FlickV2][HOOK] ==============================")
                end
            end

            return oldNamecall(self, ...)
        end)
        setro(mt, true)
    end)

    if not okSet then
        hookInstalled, hookErr = false, tostring(err)
        return false
    end

    hookInstalled = true
    return true
end

-- ===================== PREDICT =====================
local function getPingSeconds()
    local ok, v = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    return ok and (v / 1000) or 0
end

local velCache = {}           -- part → { {v, t}, ... }
local velCacheLastSweep = 0

local function sweepVelCache(now)
    for key, entries in pairs(velCache) do
        local lastT = entries[#entries] and entries[#entries].t or 0
        if now - lastT > 2 then
            velCache[key] = nil
        end
    end
end

local function smoothedVelocity(part)
    local raw = part.AssemblyLinearVelocity
    if not Config.VelocitySmooth then return raw end
    local key = part
    local now = os.clock()
    if now - velCacheLastSweep > 30 then
        velCacheLastSweep = now
        sweepVelCache(now)
    end
    local c = velCache[key]
    if not c then c = {}; velCache[key] = c end
    table.insert(c, { v = raw, t = now })
    while #c > 0 and now - c[1].t > 0.1 do table.remove(c, 1) end
    local sum = Vector3.zero
    for _, e in ipairs(c) do sum = sum + e.v end
    return #c > 0 and (sum / #c) or Vector3.zero
end

local function predictedPosition(part)
    if not Config.PredictEnabled then return part.Position end
    local vel = smoothedVelocity(part)
    if vel.Magnitude < 0.05 then return part.Position end
    local offset = Vector3.new(
        vel.X * Config.PredictXZ,
        vel.Y * Config.PredictY,
        vel.Z * Config.PredictXZ
    )
    if Config.PingComp then
        offset = offset + vel * (getPingSeconds() * 0.5)
    end
    return part.Position + offset
end

-- ===================== [C3] CACHE LOOP (token-bound) =====================
local murdererCache = nil
local cacheTicks = 0

local function findMurdererOnce()
    if game.PlaceId == 142823291 then
        local ok, data = pcall(function()
            local rf = RS:FindFirstChild("GetPlayerData", true)
            if rf and rf:IsA("RemoteFunction") then
                return rf:InvokeServer()
            end
        end)
        if ok and type(data) == "table" then
            for key, info in pairs(data) do
                if type(info) == "table"
                    and tostring(info.Role or ""):lower() == "murderer"
                    and not info.Killed and not info.Dead
                then
                    local p = (typeof(key) == "Instance" and key:IsA("Player") and key)
                        or Players:FindFirstChild(tostring(key))
                    if p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        return p
                    end
                end
            end
        end
        return nil
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                for _, c in ipairs(p.Character:GetChildren()) do
                    if c:IsA("Tool") and c.Name == "Knife" then return p end
                end
                local bp = p:FindFirstChild("Backpack")
                if bp and bp:FindFirstChild("Knife") then return p end
            end
        end
    end
    return nil
end

local function startCacheLoop()
    task.spawn(function()
        while getgenv()._flickV2Token == INSTANCE_TOKEN do
            local ok, res = pcall(findMurdererOnce)
            murdererCache = ok and res or nil
            cacheTicks = cacheTicks + 1
            local deadline = os.clock() + Config.CacheInterval
            while os.clock() < deadline do
                if getgenv()._flickV2Token ~= INSTANCE_TOKEN then return end
                task.wait(0.05)
            end
        end
    end)
end

-- ===================== GUN =====================
local function findGunEquipped()
    local char = LP.Character
    if not char then return nil end
    for _, c in ipairs(char:GetChildren()) do
        if c:IsA("Tool") and c.Name == "Gun" then return c end
    end
    return nil
end

local function findGunAnywhere()
    local eq = findGunEquipped()
    if eq then return eq end
    local bp = LP:FindFirstChild("Backpack")
    if bp then
        local g = bp:FindFirstChild("Gun")
        if g and g:IsA("Tool") then return g end
    end
    return nil
end

-- [C4] ожидание ChildAdded с таймаутом, без фиксированного wait
local function equipGunIfNeeded()
    if findGunEquipped() then return true end
    local char = LP.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    local bp = LP:FindFirstChild("Backpack")
    local g = bp and bp:FindFirstChild("Gun")
    if not (g and g:IsA("Tool")) then return false end

    local arrived = false
    local conn
    conn = char.ChildAdded:Connect(function(child)
        if child:IsA("Tool") and child.Name == "Gun" then arrived = true end
    end)

    pcall(function() hum:EquipTool(g) end)

    local deadline = os.clock() + 0.5
    while os.clock() < deadline and not arrived do
        task.wait(0.02)
    end

    if conn then conn:Disconnect() end
    return findGunEquipped() ~= nil
end

local function unequipGun()
    local gun = findGunEquipped()
    if not gun then return end
    local bp = LP:FindFirstChild("Backpack")
    if bp then pcall(function() gun.Parent = bp end) end
end

-- ===================== [C5] REMOTE =====================
local shootRemote = nil

local function isShootRemote(inst)
    if not (inst and inst:IsA("RemoteEvent")) then return false end
    if inst.Name ~= "Shoot" then return false end
    local par = inst.Parent
    if not par then return false end
    if par.Name == "Gun" then return true end
    if par.Parent and par.Parent.Name == "Gun" then return true end
    return false
end

local function resolveShootRemote()
    if shootRemote and shootRemote.Parent then return shootRemote end

    local remotes = RS:FindFirstChild("Remotes")
    if remotes then
        local gun = remotes:FindFirstChild("Gun")
        if gun then
            local s = gun:FindFirstChild("Shoot")
            if isShootRemote(s) then shootRemote = s; return s end
        end
    end

    local ok, result = pcall(function()
        for _, d in ipairs(RS:GetDescendants()) do
            if isShootRemote(d) then return d end
        end
    end)
    if ok and result then shootRemote = result; return result end
    return nil
end

-- [C1-fallback] один вызов. Без двойного pcall. Внутренний guard глушит
-- дамп от нашего же вызова, чтобы не засорять консоль.
local function fireShoot(remote, camCF, targetPos)
    if not remote then return false, "no_remote" end
    internalFireGuard = true
    local ok = pcall(function()
        remote:FireServer(camCF, targetPos)
    end)
    internalFireGuard = false
    return ok, ok and "fired" or "fire_failed"
end

-- ===================== [C6] WALL =====================
local function hasLineOfSight(targetPos)
    local char = LP.Character
    if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    local origin = root.Position + Vector3.new(0, 1.5, 0)

    local filter = { char }
    if murdererCache and murdererCache.Character then
        table.insert(filter, murdererCache.Character)
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = filter
    params.IgnoreWater = true

    local hit = workspace:Raycast(origin, targetPos - origin, params)
    return hit == nil
end

-- ===================== FLICK =====================
local firing = false
local lastFlickAt = 0

local function visualBodyFlick(targetPos, instant)
    local char = LP.Character
    if not char then return end
    local hum  = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return end

    local wasAuto = hum.AutoRotate
    pcall(function()
        hum.AutoRotate = false
        local flatTarget = Vector3.new(targetPos.X, root.Position.Y, targetPos.Z)
        if (flatTarget - root.Position).Magnitude < 0.5 then return end
        local targetCFrame = CFrame.lookAt(root.Position, flatTarget)
        if instant then
            root.CFrame = targetCFrame
            RunService.Heartbeat:Wait()
        else
            local origCFrame = root.CFrame
            local angle = math.acos(math.clamp(
                origCFrame.LookVector:Dot(targetCFrame.LookVector), -1, 1))
            local totalTime = math.clamp(
                angle / (math.max(Config.FlickSpeed, 1) * 2), 0.02, 0.4)
            local steps = math.clamp(math.floor(totalTime * 60), 4, 30)
            for i = 1, steps do
                root.CFrame = origCFrame:Lerp(targetCFrame, i / steps)
                RunService.RenderStepped:Wait()
            end
        end
    end)
    pcall(function() hum.AutoRotate = wasAuto end)
end

local function computeCameraCFrame(targetPos)
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    return CFrame.lookAt(cam.CFrame.Position, targetPos)
end

local function flick()
    if not Config.Enabled then
        notify("Flick disabled.", 1); return
    end

    local now = os.clock()
    if now - lastFlickAt < Config.FlickCooldown then return end
    lastFlickAt = now

    if firing then return end
    firing = true

    local murderer = murdererCache
    if not murderer or not murderer.Parent or not murderer.Character then
        notify("No cached murderer", 1); firing = false; return
    end

    local tRoot = murderer.Character:FindFirstChild("HumanoidRootPart")
    local tHum  = murderer.Character:FindFirstChildOfClass("Humanoid")
    if not tRoot or not tHum or tHum.Health <= 0 then
        notify("Murderer unavailable.", 1); firing = false; return
    end

    local targetPos = predictedPosition(tRoot)

    if Config.WallCheck and not hasLineOfSight(targetPos) then
        notify("Wall between you and target.", 1); firing = false; return
    end

    local camCF = computeCameraCFrame(targetPos)
    if not camCF then firing = false; return end

    if Config.AutoShoot then
        if not findGunAnywhere() then
            notify("No Gun in inventory.", 1); firing = false; return
        end
        if not equipGunIfNeeded() then
            notify("Equip failed.", 1); firing = false; return
        end
        local remote = resolveShootRemote()
        if not remote then
            notify("Shoot remote not found.", 1); firing = false; return
        end
        -- [C1] один вызов: (camCF, targetPos). Хук выше пишет реальную
        -- сигнатуру в консоль — по ней при необходимости переключим порядок.
        fireShoot(remote, camCF, targetPos)
        if Config.AutoUnequip then unequipGun() end
    end

    task.spawn(function()
        visualBodyFlick(targetPos, Config.InstantFlick)
        firing = false
    end)
end

-- ===================== KEYBIND =====================
local waitingForBind = false
local keyConn = nil

local function setupKeybind()
    if keyConn then keyConn:Disconnect() end
    keyConn = UIS.InputBegan:Connect(function(input, processed)
        if processed then return end
        if waitingForBind then
            waitingForBind = false
            if input.KeyCode ~= Enum.KeyCode.Unknown then
                Config.Keybind = input.KeyCode.Name
                saveConfig()
                notify("Keybind set: " .. Config.Keybind, 1)
            end
            return
        end
        if input.KeyCode == Enum.KeyCode[Config.Keybind] then
            flick()
        end
    end)
end

local function startBind()
    waitingForBind = true
    notify("Press a key to bind...", 3)
    task.delay(3, function()
        if waitingForBind then
            waitingForBind = false
            notify("Bind cancelled.", 1)
        end
    end)
end

-- ===================== [C7] DISCONNECT =====================
local function disconnect()
    -- рвём бинд
    if keyConn then keyConn:Disconnect(); keyConn = nil end
    waitingForBind = false
    -- убиваем цикл через токен
    if getgenv()._flickV2Token == INSTANCE_TOKEN then
        getgenv()._flickV2Token = nil
    end
    -- отпускаем ссылки, которые держат GC
    shootRemote      = nil
    murdererCache    = nil
    velCache         = {}
    observedSignature = nil
    destroyNotify()
end

