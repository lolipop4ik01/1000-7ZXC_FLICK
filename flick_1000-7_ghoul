function findMurderer()
    if game.PlaceId == 142823291 then
        local success, roleData = pcall(function() local remote = ReplicatedStorage:FindFirstChild("GetPlayerData", true); if remote and remote:IsA("RemoteFunction") then return remote:InvokeServer() end end)
        if success and roleData then
            for playerName, data in pairs(roleData) do
                if data.Role == "Murderer" and not data.Killed and not data.Dead then local p = Players:FindFirstChild(playerName); if p then return p end end
            end
        end
        return nil
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character; local root = char:FindFirstChild("HumanoidRootPart"); local hum = char:FindFirstChild("Humanoid")
            if root and hum and hum.Health > 0 then
                if player:FindFirstChild("Backpack") and player.Backpack:FindFirstChild("Knife") then return player end
                for _, tool in ipairs(char:GetChildren()) do if tool:IsA("Tool") and tool.Name == "Knife" then return player end end
            end
        end
    end
    return nil
end

local function findShootRemote()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if not remotes then return nil end
    local gunFolder = remotes:FindFirstChild("Gun")
    if not gunFolder then return nil end
    return gunFolder:FindFirstChild("Shoot")
end

local function fireOnce(targetPos)
    local cam = workspace.CurrentCamera
    if not cam then return end
    local remote = findShootRemote()
    if remote then
        pcall(function() remote:FireServer(targetPos) end)
        pcall(function() remote:FireServer(CFrame.new(targetPos)) end)
        pcall(function() remote:FireServer({ cam.CFrame, CFrame.new(targetPos) }) end)
    end
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local gun = char:FindFirstChild("Gun") or (backpack and backpack:FindFirstChild("Gun"))
    if gun and gun:IsA("Tool") and hum then
        if gun.Parent ~= char then pcall(function() hum:EquipTool(gun) end); task.wait(0.05) end
        pcall(function() gun:Activate() end)
        pcall(function() local vu = game:GetService("VirtualUser"); vu:Button1Down(Vector2.zero); vu:Button1Up(Vector2.zero) end)
    end
end

local function returnCameraWithRandomness(token)
    if not Config.ReturnCamera or not lastCameraCFrame then return false end
    if token and token ~= returnToken then return false end

    local savedCFrame = lastCameraCFrame
    local savedRootPos = lastCameraRootPos

    local cam = workspace.CurrentCamera
    local randomX = (math.random() - 0.5) * 2 * (Config.ReturnRandomnessX / 100)
    local randomY = (math.random() - 0.5) * 2 * (Config.ReturnRandomnessY / 100)
    local newLook = (savedCFrame.LookVector + savedCFrame.RightVector * randomX + savedCFrame.UpVector * randomY).Unit

    local targetCFrame
    local char = LocalPlayer.Character
    local rootPart = char and char:FindFirstChild("HumanoidRootPart")
    if rootPart and savedRootPos then
        local offsetPos = savedCFrame.Position - savedRootPos
        targetCFrame = CFrame.new(rootPart.Position + offsetPos) * (savedCFrame - savedCFrame.Position)
    else
        targetCFrame = CFrame.lookAt(savedCFrame.Position, savedCFrame.Position + newLook)
    end

    local oldCFrame = cam.CFrame
    local angleDist = math.acos(math.clamp(oldCFrame.LookVector:Dot(targetCFrame.LookVector), -1, 1))
    local totalTime = math.clamp(angleDist / (Config.ReturnSpeed * 2), 0.01, 0.35)
    local steps = math.clamp(math.floor(60 * totalTime), 8, 40)

    for i = 1, steps do
        if token and token ~= returnToken then return false end
        cam.CFrame = oldCFrame:Lerp(targetCFrame, i / steps)
        task.wait(totalTime / steps)
    end
    return true
end

function flickToMurderer()
    if not Config.Enabled then notify("Flick is disabled!", 1) return end
    local murderer = findMurderer()
    if not murderer or not murderer.Character then notify("Murderer not found!", 1) return end

    local cam = workspace.CurrentCamera; local char = LocalPlayer.Character
    if not char then return end
    local rootPart = char:FindFirstChild("HumanoidRootPart"); local hum = char:FindFirstChildOfClass("Humanoid")
    if not rootPart or not hum then return end

    local targetPart = murderer.Character:FindFirstChild(Config.TargetPart) or murderer.Character:FindFirstChild("HumanoidRootPart")
    if not targetPart then notify("Target part not found!", 1) return end

    -- Save return position ONLY on fresh session
    if Config.ReturnCamera and not camState.session then
        lastCameraCFrame = cam.CFrame
        lastCameraRootPos = rootPart.Position
        camState.session = true
    end

    -- Lock camera/autorotate (idempotent, saves original only once)
    lockCamState(Config.CameraLock and cam or nil, Config.AutoRotateLock and hum or nil)

    local targetPos = computeTargetPosition(targetPart)
    if not targetPos then notify("Cannot get target position!", 1) return end

    local flatTarget = Vector3.new(targetPos.X, rootPart.Position.Y, targetPos.Z)
    local dir = flatTarget - rootPart.Position
    if dir.Magnitude < 0.01 then return end
    local newHRPCFrame = CFrame.lookAt(rootPart.Position, rootPart.Position + dir.Unit)

    local headPos = char:FindFirstChild("Head") and char.Head.Position or rootPart.Position
    local isFirstPerson = (cam.CFrame.Position - headPos).Magnitude < 5
    local newCamCFrame
    if isFirstPerson then
        newCamCFrame = CFrame.lookAt(cam.CFrame.Position, targetPos)
    else
        local offset = cam.CFrame.Position - rootPart.Position
        local flatOffset = Vector3.new(offset.X, 0, offset.Z)
        local flatTargetDir = Vector3.new(targetPos.X - rootPart.Position.X, 0, targetPos.Z - rootPart.Position.Z)
        if flatOffset.Magnitude > 0.1 and flatTargetDir.Magnitude > 0.1 then
            local targetAngle = math.atan2(-flatTargetDir.X, -flatTargetDir.Z)
            local currentAngle = math.atan2(flatOffset.X, flatOffset.Z)
            local angle = targetAngle - currentAngle
            local rotatedOffset = CFrame.Angles(0, angle, 0) * offset
            newCamCFrame = CFrame.lookAt(rootPart.Position + rotatedOffset, targetPos)
        else
            newCamCFrame = CFrame.lookAt(cam.CFrame.Position, targetPos)
        end
    end

    -- Lerp token (abort if newer flick starts)
    flickLerpToken = flickLerpToken + 1
    local myFlickToken = flickLerpToken

    if Config.InstantFlick then
        rootPart.CFrame = newHRPCFrame; cam.CFrame = newCamCFrame
    else
        local oldCFrame = cam.CFrame; local oldHRP = rootPart.CFrame
        local angleDist = math.acos(math.clamp(oldCFrame.LookVector:Dot((targetPos - oldCFrame.Position).Unit), -1, 1))
        local totalTime = math.clamp(angleDist / (Config.FlickSpeed * 2), 0.01, 0.35)
        local steps = math.clamp(math.floor(60 * totalTime), 8, 40)
        for i = 1, steps do
            if flickLerpToken ~= myFlickToken then return end
            if not rootPart.Parent then return end
            local a = i / steps
            rootPart.CFrame = oldHRP:Lerp(newHRPCFrame, a)
            cam.CFrame = oldCFrame:Lerp(newCamCFrame, a)
            task.wait(totalTime / steps)
        end
    end

    if Config.ReplicationSync then RunService.Heartbeat:Wait(); RunService.Heartbeat:Wait() end
    if flickLerpToken ~= myFlickToken then return end

    if Config.AutoShoot then
        if Config.BurstFire then
            local count = math.max(1, math.floor(Config.BurstCount)); local delay = math.max(0, Config.BurstDelay / 1000)
            for i = 1, count do
                if flickLerpToken ~= myFlickToken then return end
                local tp = murderer.Character and (murderer.Character:FindFirstChild(Config.TargetPart) or murderer.Character:FindFirstChild("HumanoidRootPart"))
                if not tp or not tp.Parent then break end
                local p = computeTargetPosition(tp)
                if p then
                    local fT = Vector3.new(p.X, rootPart.Position.Y, p.Z); local d = fT - rootPart.Position
                    if d.Magnitude > 0.01 then rootPart.CFrame = CFrame.lookAt(rootPart.Position, rootPart.Position + d.Unit) end
                    if cam then cam.CFrame = CFrame.lookAt(cam.CFrame.Position, p) end
                    if Config.ReplicationSync then RunService.Heartbeat:Wait() end
                    fireOnce(p)
                end
                if i < count and delay > 0 then task.wait(delay) end
            end
        else
            local tp = murderer.Character and (murderer.Character:FindFirstChild(Config.TargetPart) or murderer.Character:FindFirstChild("HumanoidRootPart"))
            local p = tp and computeTargetPosition(tp)
            if p then
                local fT = Vector3.new(p.X, rootPart.Position.Y, p.Z); local d = fT - rootPart.Position
                if d.Magnitude > 0.01 then rootPart.CFrame = CFrame.lookAt(rootPart.Position, rootPart.Position + d.Unit) end
                if cam then cam.CFrame = CFrame.lookAt(cam.CFrame.Position, p) end
                fireOnce(p)
            end
        end
    end

    -- Schedule return with unique token
    returnToken = returnToken + 1
    local myToken = returnToken

    if Config.ReturnCamera then
        task.spawn(function()
            task.wait(Config.ReturnDelay / 1000)
            local success = returnCameraWithRandomness(myToken)
            if myToken == returnToken then
                if success then
                    lastCameraCFrame = nil
                    lastCameraRootPos = nil
                end
                camState.session = false
                unlockCamState(cam, hum)
            end
        end)
    else
        task.delay(0.05, function()
            if myToken == returnToken then
                camState.session = false
                unlockCamState(cam, hum)
            end
        end)
    end
end

