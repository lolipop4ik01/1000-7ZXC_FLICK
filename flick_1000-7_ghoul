local function notify(text, dur)
    if not Config.Notifications then return end
    pcall(function()
        local parent = safeParent()
        local sg = parent:FindFirstChild("FlickNotifyV4")
        if not sg then
            sg = Instance.new("ScreenGui")
            sg.Name = "FlickNotifyV4"
