-- ===================== PREDICT =====================
local function getPingSeconds()
    local ok, v = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
    return ok and (v / 1000) or 0
end

local velCache = {}
local function smoothedVelocity(part)
    local raw = part.AssemblyLinearVelocity
    if not Config.VelocitySmooth then return raw end
    local key = tostring(part); local now = os.clock()
    local c = velCache[key]; if not c then c = {}; velCache[key] = c end
    table.insert(c, { v = raw, t = now, part = part })
    while #c > 0 and now - c[1].t > 0.1 do table.remove(c, 1) end
    local sum = Vector3.zero
    for _, e in ipairs(c) do sum = sum + e.v end
    return #c > 0 and (sum / #c) or Vector3.zero
end

task.spawn(function()
    while isCurrentInstance() do
        task.wait(10)
        for key, entries in pairs(velCache) do
            if #entries == 0 or not entries[#entries].part or not entries[#entries].part.Parent then velCache[key] = nil end
        end
    end
end)

local function predictedPosition(part)
    if not Config.PredictEnabled then return part.Position end
    local vel = smoothedVelocity(part)
    if vel.Magnitude < 0.05 then return part.Position end
    local offset = Vector3.new(vel.X * Config.PredictXZ, vel.Y * Config.PredictY, vel.Z * Config.PredictXZ)
    if Config.PingComp then offset = offset + vel * (getPingSeconds() * 0.5) end
    return part.Position + offset
end

-- ===================== CACHE =====================
local murdererCache = nil
local cacheTicks    = 0

local function findMurdererOnce()
    if game.PlaceId == 142823291 then
        local ok, data = pcall(function()
            local rf = RS:FindFirstChild("GetPlayerData", true)
            if rf and rf:IsA("RemoteFunction") then return rf:InvokeServer() end
        end)
        if ok and type(data) == "table" then
            for key, info in pairs(data) do
                local role = nil
                if type(info) == "table" then role = info.Role or info.role or info.RoleId elseif type(info) == "string" then role = info end
                local sRole = tostring(role):lower()
                if sRole == "murderer" or sRole == "1" then
                    local p = nil
                    if type(key) == "string" then p = Players:FindFirstChild(key)
                    elseif type(key) == "number" then p = Players:GetPlayerByUserId(key)
                    elseif typeof(key) == "Instance" and key:IsA("Player") then p = key end
                    if p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then return p end
                end
            end
        end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                for _, c in ipairs(p.Character:GetChildren()) do if c:IsA("Tool") and c.Name == "Knife" then return p end end
                local bp = p:FindFirstChild("Backpack"); if bp and bp:FindFirstChild("Knife") then return p end
            end
        end
    end
    return nil
end

local function startCacheLoop()
    task.spawn(function()
        while isCurrentInstance() do
            local ok, res = pcall(findMurdererOnce)
            if not isCurrentInstance() then break end
            murdererCache = ok and res or nil
            cacheTicks = cacheTicks + 1
            task.wait(Config.CacheInterval)
        end
    end)
end

-- ===================== GUN & REMOTE =====================
local function findGunEquipped()
    local char = LP.Character; if not char then return nil end
    for _, c in ipairs(char:GetChildren()) do if c:IsA("Tool") and c.Name == "Gun" then return c end end
    return nil
end

local function findGunAnywhere()
    local eq = findGunEquipped(); if eq then return eq end
    local bp = LP:FindFirstChild("Backpack")
    if bp then local g = bp:FindFirstChild("Gun"); if g and g:IsA("Tool") then return g end end
    return nil
end

local function unequipGun()
    local gun = findGunEquipped(); if not gun then return end
    local bp = LP:FindFirstChild("Backpack"); if bp then pcall(function() gun.Parent = bp end) end
end

local function equipGunIfNeeded()
    if findGunEquipped() then return true end
    local char = LP.Character; local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    local bp = LP:FindFirstChild("Backpack"); local g = bp and bp:FindFirstChild("Gun")
    if not (g and g:IsA("Tool")) then return false end

    local arrived = false
    local conn = char.ChildAdded:Connect(function(c) if c == g then arrived = true end end)
    pcall(function() hum:EquipTool(g) end)

    local deadline = os.clock() + Config.EquipTimeout
    while not arrived and os.clock() < deadline and isCurrentInstance() do RunService.Heartbeat:Wait() end
    if conn then conn:Disconnect() end
    return findGunEquipped() ~= nil
end

local function resolveShootRemote()
    -- 1. Ищем внутри экипированного оружия (как в логах)
    local gun = findGunEquipped()
    if gun then
        for _, v in ipairs(gun:GetDescendants()) do
            if v:IsA("RemoteEvent") then return v end
        end
    end
    -- 2. Ищем по стандартному пути
    local remotes = RS:FindFirstChild("Remotes")
    if remotes and remotes:FindFirstChild("Gun") then
        local s = remotes.Gun:FindFirstChild("Shoot")
        if s and s:IsA("RemoteEvent") then return s end
    end
    -- 3. Рекурсивно в RS
    for _, d in ipairs(RS:GetDescendants()) do
        if d:IsA("RemoteEvent") and d.Name == "Shoot" then return d end
    end
    return nil
end

-- ===================== HOOK =====================
local function installFireServerHook()
    local hasGetRawMeta  = (type(getrawmetatable) == "function")
    local hasSetReadonly = (type(setreadonly)    == "function")
    local hasCheckCaller = (type(checkcaller)    == "function")
    local hasGetNamecall = (type(getnamecallmethod) == "function")
    if not (hasGetRawMeta and hasSetReadonly and hasGetNamecall) then return end

    local mt = getrawmetatable(game)
    if type(mt) ~= "table" then return end
    local oldNamecall = mt.__namecall
    if type(oldNamecall) ~= "function" then return end

    local function logFireServer(self, ...)
        if getnamecallmethod() ~= "FireServer" then return end
        if hasCheckCaller and checkcaller() then return end
        local isRemote = false; pcall(function() isRemote = self:IsA("RemoteEvent") end)
        if not isRemote then return end
        
        local pPath = self.Parent and self.Parent:GetFullName() or "?"
        if string.find(string.lower(pPath), "gun") or string.lower(self.Name) == "shoot" then
            if Config.DebugHook then
                local args = table.pack(...)
                print(("[FlickV7-HOOK] FireServer → %s | nargs=%d"):format(pPath, args.n))
                for i = 1, args.n do print(("  arg[%d] : %s = %s"):format(i, typeof(args[i]), tostring(args[i]))) end
            end
        end
    end

    -- Защищаем вызов oldNamecall, чтобы скрипт НИКОГДА не блокировал ручной выстрел
    local function wrapper(self, ...)
        pcall(logFireServer, self, ...) -- Если лог упадет, игра продолжит работу
        return oldNamecall(self, ...)
    end

    setreadonly(mt, false)
    mt.__namecall = newcclosure and newcclosure(wrapper) or wrapper
    setreadonly(mt, true)
    print("[FlickV7-HOOK] Установлен. Ручной выстрел защищен.")
end

local function fireShoot(targetPos, camCF)
    local remote = resolveShootRemote()
    if not remote then return false, "no_remote" end
    -- Сигнатура из логов: (CFrame, CFrame)
    local ok = pcall(function() remote:FireServer(camCF, CFrame.new(targetPos)) end)
    return ok
end

-- ===================== FLICK LOGIC =====================
local firing = false
local lastFlickAt = 0

local function hasLineOfSight(targetPos)
    local char = LP.Character; if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart"); if not root then return false end
    local filter = { char }
    if murdererCache and murdererCache.Character then table.insert(filter, murdererCache.Character) end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances = filter
    return workspace:Raycast(root.Position, targetPos - root.Position, params) == nil
end

local function visualBodyFlick(targetPos, instant)
    local char = LP.Character; if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid"); local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return end
    local wasAuto = hum.AutoRotate

    pcall(function()
        hum.AutoRotate = false
        local flatTarget = Vector3.new(targetPos.X, root.Position.Y, targetPos.Z)
        if (flatTarget - root.Position).Magnitude < 0.5 then return end
        local targetCFrame = CFrame.lookAt(root.Position, flatTarget)
        if instant then
            root.CFrame = targetCFrame; RunService.Heartbeat:Wait()
        else
            local origCFrame = root.CFrame
            local angle = math.acos(math.clamp(origCFrame.LookVector:Dot(targetCFrame.LookVector), -1, 1))
            local totalTime = math.clamp(angle / (math.max(Config.FlickSpeed, 1) * 2), 0.02, 0.4)
            local steps = math.clamp(math.floor(totalTime * 60), 4, 30)
            for i = 1, steps do
                if not isCurrentInstance() then break end
                root.CFrame = origCFrame:Lerp(targetCFrame, i / steps); RunService.RenderStepped:Wait()
            end
        end
    end)
    pcall(function() hum.AutoRotate = wasAuto end)
end

local function computeShot()
    local murderer = murdererCache
    if not murderer or not murderer.Parent or not murderer.Character then return nil, "no_cached_murderer" end
    local tRoot = murderer.Character:FindFirstChild("HumanoidRootPart")
    local tHum = murderer.Character:FindFirstChildOfClass("Humanoid")
    if not tRoot or not tHum or tHum.Health <= 0 then return nil, "murderer_unavailable" end
    local targetPos = predictedPosition(tRoot)
    if Config.WallCheck and not hasLineOfSight(targetPos) then return nil, "wall" end
    local cam = workspace.CurrentCamera
    local camCF = cam and CFrame.lookAt(cam.CFrame.Position, targetPos) or nil
    if not camCF then return nil, "no_camera" end
    return { murderer = murderer, targetPos = targetPos, camCF = camCF, remote = resolveShootRemote() }
end

local function flick()
    if not isCurrentInstance() or not Config.Enabled then return end
    if firing then return end
    local now = os.clock()
    if now - lastFlickAt < Config.FlickCooldown then return end
    lastFlickAt = now
    firing = true

    local okRun, err = pcall(function()
        local shot, reason = computeShot()
        if not shot then
            if reason == "no_cached_murderer" then notify("No cached murderer", 1) end
            return
        end
        visualBodyFlick(shot.targetPos, Config.InstantFlick)
        if not Config.AutoShoot then return end
        if not findGunAnywhere() then notify("No Gun.", 1); return end
        if not equipGunIfNeeded() then notify("Equip timeout.", 1); return end
        if not shot.remote then notify("No remote.", 1); return end
        local okFire = fireShoot(shot.targetPos, shot.camCF)
        if not okFire then notify("Fire failed.", 1) end
        if Config.AutoUnequip then unequipGun() end
    end)

    firing = false
    if not okRun and err then warn("[FlickV7] Error: " .. tostring(err)) end
end

-- ===================== KEYBIND =====================
local function setupKeybind()
    track(UIS.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.KeyCode == Enum.KeyCode[Config.Keybind] then task.spawn(flick) end
    end))
end

local function startBind()
    notify("Press a key to bind...", 3)
    local conn; local done = false
    conn = UIS.InputBegan:Connect(function(input, processed)
        if input.KeyCode ~= Enum.KeyCode.Unknown then
            done = true; Config.Keybind = input.KeyCode.Name
            saveConfig(); conn:Disconnect(); notify("Keybind set: " .. Config.Keybind, 1)
            if getgenv()._flickV7.UpdateBindUI then getgenv()._flickV7.UpdateBindUI(Config.Keybind) end
        end
    end)
    task.delay(5, function()
        if not done then conn:Disconnect(); notify("Bind cancelled.", 1) end
    end)
end

