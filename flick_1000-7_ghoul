-- ===================== G3-DRAG =====================
local function makeDraggable(gui, handle, clickThreshold)
    clickThreshold = clickThreshold or 5
    local dragging  = false
    local dragStart, startPos = nil, nil
    local movedDist = 0

    local connA = handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging  = true
            dragStart = input.Position
            startPos  = gui.Position
            movedDist = 0
        end
    end)
    Track(connA)

    local connB = handle.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    Track(connB)

    local connC = UIS.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local delta = input.Position - dragStart
        movedDist = math.max(movedDist, math.sqrt(delta.X*delta.X + delta.Y*delta.Y))
        gui.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end)
    Track(connC)

    return function()
        return movedDist, movedDist > clickThreshold
    end
end

