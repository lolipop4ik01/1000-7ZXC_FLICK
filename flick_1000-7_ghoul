    W.toggle(scroll, "Enable Flick",  "Enabled")
    W.toggle(scroll, "Instant Flick", "InstantFlick")
    W.slider(scroll, "Flick Speed",        "FlickSpeed",    1,    240,  false, 1)
    W.slider(scroll, "Flick Cooldown (s)", "FlickCooldown", 0.05, 1.0,  true,  0.01)

    W.section(scroll, "SHOOT")
    W.toggle(scroll, "Auto Shoot", "AutoShoot")
    W.toggle(scroll, "Auto Unequip After Shot", "AutoUnequip")
    W.toggle(scroll, "Wall Check (Raycast from HRP)", "WallCheck")
    W.slider(scroll, "Equip Timeout (s)", "EquipTimeout", 0.1, 1.0, true, 0.01)

    W.section(scroll, "AIM PREDICT")
    W.toggle(scroll, "Predict", "PredictEnabled")
    W.toggle(scroll, "Ping Compensation", "PingComp")
    W.toggle(scroll, "Velocity Smoothing", "VelocitySmooth")
    W.slider(scroll, "Predict X/Z", "PredictXZ", 0.0, 0.5, true, 0.001)
    W.slider(scroll, "Predict Y",   "PredictY",  0.0, 0.2, true, 0.001)

    W.section(scroll, "SYSTEM")
    W.toggle(scroll, "Notifications", "Notifications")
    W.toggle(scroll, "Debug Hook (Print FireServer args)", "DebugHook")
    W.slider(scroll, "Cache Interval (s)", "CacheInterval", 0.25, 5.0, true, 0.05)

    -- ---------- QUICK ACTIONS ----------
    W.section(scroll, "ACTIONS")
    W.button(scroll, "🎯 FLICK NOW (task.spawn)", function()
        task.spawn(Flick)
    end, Color3.fromRGB(60, 80, 60))

    local bindBtn = W.button(scroll,
        "⌨️ BIND: " .. Config.Keybind,
        function()
            bindBtn.Text = "⌨️ PRESS A KEY..."
            StartBind()
            task.delay(3.2, function()
                if bindBtn and bindBtn.Parent then
                    bindBtn.Text = "⌨️ BIND: " .. Config.Keybind
                end
            end)
        end,
        Color3.fromRGB(55, 50, 40))

    -- ---------- CACHE STATUS ----------
    local cacheLabel = Instance.new("TextLabel")
    cacheLabel.Size = UDim2.new(1, 0, 0, 22)
    cacheLabel.BackgroundTransparency = 1
    cacheLabel.Text = "cache: —"
    cacheLabel.TextColor3 = Theme.textDim
    cacheLabel.Font = Enum.Font.Gotham
    cacheLabel.TextSize = 11
    cacheLabel.TextXAlignment = Enum.TextXAlignment.Left
    cacheLabel.Parent = scroll

    task.spawn(function()
        while cacheLabel and cacheLabel.Parent do
            local p, ticks = GetCache()
            local name = p and p.Name or "nil"
            cacheLabel.Text = string.format("cache: %s (ticks=%d)", name, ticks or 0)
            task.wait(1)
        end
    end)

    -- ---------- FINAL ACTIONS ----------
    W.button(scroll, "👁 Hide GUI", function()
        frame.Visible = false
    end, Color3.fromRGB(40, 40, 50))

    W.button(scroll, "🔁 Save Config", function()
        Save()
        Notify("Config saved.", 1)
    end, Color3.fromRGB(40, 45, 55))

    W.button(scroll, "💀 Unload (stop script)", function()
        Notify("Unloading...", 2)
        task.wait(0.05)
        pcall(Disconnect)       -- [8] отключает бинд, кэш, нотификации
        pcall(function() gui:Destroy() end)
    end, Theme.danger)

    -- ---------- FLOATING CLICK (drag vs click) ----------
    Track(circle.MouseButton1Click:Connect(function()
        local _, isDrag = getDragState()
        if isDrag then return end
        frame.Visible = not frame.Visible
    end))

    Track(frame:GetPropertyChangedSignal("Visible"):Connect(function()
        gui.DisplayOrder = frame.Visible and 11 or 10
    end))

    return gui
end

