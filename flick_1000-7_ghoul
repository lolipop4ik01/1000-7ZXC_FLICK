    task.spawn(function()
        while cacheLabel and cacheLabel.Parent do
            local p, ticks = GetCache()
            local name = p and p.Name or "nil"
            cacheLabel.Text = string.format("cache: %s (ticks=%d)", name, ticks or 0)
            task.wait(1)
        end
    end)

    -- ---------- FINAL ----------
