local function getPing()
    local ok, v = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    return (ok and v and v > 0) and (v / 1000) or 0
end

-- ========== VELOCITY / PREDICT ==========
local velCache = {}
local function getSmoothedVelocity(part)
    if not Config.VelocitySmooth then return part.AssemblyLinearVelocity end
    local now = tick()
    local key = tostring(part)
    if not velCache[key] then velCache[key] = {} end
    local cache = velCache[key]
    table.insert(cache, {v = part.AssemblyLinearVelocity, t = now})
    while #cache > 0 and now - cache[1].t > 0.06 do table.remove(cache, 1) end
    if #cache == 0 then return part.AssemblyLinearVelocity end
    local total, acc = 0, Vector3.zero
    for i, e in ipairs(cache) do
        local w = i * i
        acc = acc + e.v * w
        total = total + w
    end
    return acc / total
end

local function computeTargetPosition(part)
    if not part then return nil end
    local vel = getSmoothedVelocity(part)
    local off = Vector3.zero
    if Config.ServerSidePredict then
        off = off + vel * (getPing() * 0.5)
    end
    if Config.PredictEnabled then
        local mxz, my = Config.PredictXZ, Config.PredictY
        if Config.PredictOp == "Divide" then
            if mxz > 0 then mxz = 1 / mxz end
            if my > 0 then my = 1 / my end
        end
        local px, pz = vel.X * mxz, vel.Z * mxz
        local py = 0
        local hum = part.Parent and part.Parent:FindFirstChildOfClass("Humanoid")
        local state = hum and hum:GetState()
        local airborne = state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.Jumping
        if Config.GravityPredict and airborne then
            py = vel.Y * my - 0.5 * GRAVITY * my * my
        else
            py = vel.Y * my
        end
        off = off + Vector3.new(px, py, pz)
    end
    return part.Position + off
end

-- ========== CAMERA STATE ==========
local flickToken = 0
local savedCamCFrame = nil
local savedRootPos = nil
local currentTween = nil

local function stopCurrentTween()
    if currentTween then
        pcall(function() currentTween:Cancel() end)
        currentTween = nil
    end
end

local function resetCameraToCustom()
    stopCurrentTween()
    local cam = workspace.CurrentCamera
    if cam then
        cam.CameraType = Enum.CameraType.Custom
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then cam.CameraSubject = hum end
    end
end

-- ========== DRAG SYSTEM (BEFORE GUI) ==========
local DragSystem = {}
function DragSystem.MakeDraggable(gui, dragArea)
    local dragging, dragStart, startPos = false, nil, nil
    dragArea.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = gui.Position
        end
    end)
    dragArea.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            gui.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

-- ========== MURDERER FINDER ==========
function findMurderer()
    if game.PlaceId == 142823291 then
        local ok, data = pcall(function()
            local remote = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
            if remote and remote:IsA("RemoteFunction") then return remote:InvokeServer() end
        end)
        if ok and data then
            for name, info in pairs(data) do
                if info.Role == "Murderer" and not info.Killed and not info.Dead then
                    local p = Players:FindFirstChild(name)
                    if p then return p end
                end
            end
        end
        return nil
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local char = p.Character
            local root = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if root and hum and hum.Health > 0 then
                if p:FindFirstChild("Backpack") and p.Backpack:FindFirstChild("Knife") then return p end
                for _, tool in ipairs(char:GetChildren()) do
                    if tool:IsA("Tool") and tool.Name == "Knife" then return p end
                end
            end
        end
    end
    return nil
end

-- ========== FIRE ==========
local function fireOnce(targetPos)
    local cam = workspace.CurrentCamera
    if not cam then return end
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local gunFolder = remotes and remotes:FindFirstChild("Gun")
    local remote = gunFolder and gunFolder:FindFirstChild("Shoot")
    if remote then
        pcall(function() remote:FireServer(targetPos, cam.CFrame) end)
    end
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local gun = char:FindFirstChild("Gun") or (bp and bp:FindFirstChild("Gun"))
    if gun and gun:IsA("Tool") and hum then
        if gun.Parent ~= char then
            pcall(function() hum:EquipTool(gun) end)
            RunService.Heartbeat:Wait()
        end
        pcall(function() gun:Activate() end)
        pcall(function()
            local vu = game:GetService("VirtualUser")
            vu:Button1Down(Vector2.zero)
            vu:Button1Up(Vector2.zero)
        end)
        if Config.AutoUnequip then
            task.delay(0.2, function()
                if gun and gun.Parent == char and hum then
                    pcall(function() hum:UnequipTools() end)
                end
            end)
        end
    end
end

-- ========== FLICK ==========
function flickToMurderer()
    if not Config.Enabled then notify("Flick disabled", 1) return end
    local murderer = findMurderer()
    if not murderer or not murderer.Character then notify("Murderer not found", 1) return end
    local cam = workspace.CurrentCamera
    local char = LocalPlayer.Character
    if not cam or not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local targetPart = murderer.Character:FindFirstChild(Config.TargetPart) or murderer.Character:FindFirstChild("HumanoidRootPart")
    if not targetPart then return end

    if not savedCamCFrame then
        savedCamCFrame = cam.CFrame
        savedRootPos = root.Position
    end

    local targetPos = computeTargetPosition(targetPart)
    if not targetPos then return end

    flickToken = flickToken + 1
    local myToken = flickToken

    if Config.RotateBody then
        local flat = Vector3.new(targetPos.X, root.Position.Y, targetPos.Z)
        local dir = flat - root.Position
        if dir.Magnitude > 0.01 then
            root.CFrame = CFrame.lookAt(root.Position, root.Position + dir.Unit)
        end
    end

    stopCurrentTween()
    cam.CameraType = Enum.CameraType.Scriptable
    local headPos = char:FindFirstChild("Head") and char.Head.Position or root.Position
    local isFirstPerson = (cam.CFrame.Position - headPos).Magnitude < 5
    local newCamCFrame
    if isFirstPerson then
        newCamCFrame = CFrame.lookAt(cam.CFrame.Position, targetPos)
    else
        local camOffset = cam.CFrame.Position - root.Position
        local distance = Vector3.new(camOffset.X, 0, camOffset.Z).Magnitude
        local height = camOffset.Y
        local behindDir = -(Vector3.new(targetPos.X, root.Position.Y, targetPos.Z) - root.Position).Unit
        local newCamPos = root.Position + behindDir * distance + Vector3.new(0, height, 0)
        newCamCFrame = CFrame.lookAt(newCamPos, targetPos)
    end

    if Config.InstantFlick then
        cam.CFrame = newCamCFrame
    else
        local travelTime = math.clamp(1 / (Config.FlickSpeed / 100), 0.01, 0.5)
        currentTween = TweenService:Create(cam, TweenInfo.new(travelTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {CFrame = newCamCFrame})
        currentTween:Play()
        currentTween.Completed:Wait()
        currentTween = nil
    end

    if myToken ~= flickToken then return end

    if Config.ReplicationSync then RunService.Heartbeat:Wait() end
    if myToken ~= flickToken then return end

    if Config.AutoShoot then
        local tp = murderer.Character and (murderer.Character:FindFirstChild(Config.TargetPart) or murderer.Character:FindFirstChild("HumanoidRootPart"))
        if tp then
            local p = computeTargetPosition(tp)
            if p then
                cam.CFrame = CFrame.lookAt(cam.CFrame.Position, p)
                fireOnce(p)
            end
        end
    end

    if Config.ReturnCamera then
        task.delay(Config.ReturnDelay / 1000, function()
            if myToken ~= flickToken then return end
            local targetCF = savedCamCFrame
            local curRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if curRoot and savedRootPos and targetCF then
                local offset = targetCF.Position - savedRootPos
                local newPos = curRoot.Position + offset
                targetCF = CFrame.lookAt(newPos, newPos + targetCF.LookVector)
            end
            if not targetCF then resetCameraToCustom() return end
            local rx = (math.random() - 0.5) * 2 * (Config.ReturnRandomnessX / 100)
            local ry = (math.random() - 0.5) * 2 * (Config.ReturnRandomnessY / 100)
            local newLook = (targetCF.LookVector + targetCF.RightVector * rx + targetCF.UpVector * ry).Unit
            targetCF = CFrame.lookAt(targetCF.Position, targetCF.Position + newLook)

            if Config.InstantFlick then
                cam.CFrame = targetCF
            else
                local travelTime = math.clamp(1 / (Config.ReturnSpeed / 100), 0.05, 0.5)
                currentTween = TweenService:Create(cam, TweenInfo.new(travelTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {CFrame = targetCF})
                currentTween:Play()
                currentTween.Completed:Wait()
                currentTween = nil
            end

            if myToken == flickToken then
                resetCameraToCustom()
                savedCamCFrame = nil
                savedRootPos = nil
            end
        end)
    else
        task.delay(0.05, function()
            if myToken == flickToken then
                resetCameraToCustom()
                savedCamCFrame = nil
                savedRootPos = nil
            end
        end)
    end
end

-- ========== KEYBIND ==========
local waitingForBind = false
local function setupKeybind()
    if getgenv().FlickKeybindConn then
        pcall(function() getgenv().FlickKeybindConn:Disconnect() end)
    end
    getgenv().FlickKeybindConn = UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if waitingForBind then
            waitingForBind = false
            if input.KeyCode ~= Enum.KeyCode.Unknown then
                Config.Keybind = input.KeyCode.Name
                saveConfig()
                notify("Keybind: " .. Config.Keybind, 1)
            end
            return
        end
        if input.KeyCode == Enum.KeyCode[Config.Keybind] then
            task.spawn(flickToMurderer)
        end
    end)
end

