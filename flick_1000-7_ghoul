function W.slider(scroll, label, key, minV, maxV, isFloat, step)
    step = step or (isFloat and 0.001 or 1)

    local wrap = Instance.new("Frame")
    wrap.Size = UDim2.new(1, 0, 0, 52)
    wrap.BackgroundColor3 = Theme.row
    wrap.BorderSizePixel = 0
    wrap.Parent = scroll
    Instance.new("UICorner", wrap).CornerRadius = UDim.new(0, 7)

    local name = Instance.new("TextLabel")
    name.Size = UDim2.new(1, -70, 0, 22)
    name.Position = UDim2.new(0, 12, 0, 4)
    name.BackgroundTransparency = 1
    name.TextColor3 = Theme.text
    name.Font = Enum.Font.Gotham
    name.TextSize = 12
    name.TextXAlignment = Enum.TextXAlignment.Left
    name.Parent = wrap

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(0, 56, 0, 22)
    box.Position = UDim2.new(1, -68, 0, 4)
    box.BackgroundColor3 = Theme.boxBg
    box.BorderSizePixel = 0
    box.TextColor3 = Theme.text
    box.Font = Enum.Font.Gotham
    box.TextSize = 12
    box.ClearTextOnFocus = false
    box.Parent = wrap
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 5)

    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(1, -24, 0, 6)
    bg.Position = UDim2.new(0, 12, 1, -14)
    bg.BackgroundColor3 = Theme.sliderBg
    bg.BorderSizePixel = 0
    bg.Parent = wrap
    Instance.new("UICorner", bg).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = Theme.accent
    fill.BorderSizePixel = 0
    fill.Parent = bg
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local function fmt(v)
        if isFloat then
            local s = string.format("%.3f", v):gsub("0+$", ""):gsub("%.$", "")
            return s == "" and "0" or s
        end
        return tostring(math.floor(v))
    end

    local function render()
        local v = Config[key]
        local alpha = math.clamp((v - minV) / (maxV - minV), 0, 1)
        fill.Size = UDim2.new(alpha, 0, 1, 0)
        name.Text = label
        box.Text = fmt(v)
    end
    render()

    local dragging = false
    local function setFromInput(input)
        local absX, absW = bg.AbsolutePosition.X, bg.AbsoluteSize.X
        if absW <= 0 then return end
        local rel = math.clamp((input.Position.X - absX) / absW, 0, 1)
        local raw = minV + rel * (maxV - minV)
        local snapped = math.floor(raw / step + 0.5) * step
        Config[key] = math.clamp(snapped, minV, maxV)
        render()
    end

    add(bg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setFromInput(input)
        end
    end))
    add(UIS.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            setFromInput(input)
        end
    end))
    add(UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                dragging = false
                Save()
            end
        end
    end))

    add(box.FocusLost:Connect(function()
        local n = tonumber(box.Text)
        if n then
            n = math.clamp(n, minV, maxV)
            Config[key] = math.floor(n / step + 0.5) * step
            Save()
        end
        render()
    end))

    return wrap
end

