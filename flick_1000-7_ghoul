        local fill = Instance.new("Frame", sliderBg); fill.Size = UDim2.new((getValue() - minV) / (maxV - minV), 0, 1, 0); fill.BackgroundColor3 = Color3.fromRGB(255, 100, 100)
        Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 10)
        local dragging = false
        local function upd(v) fill.Size = UDim2.new((v - minV) / (maxV - minV), 0, 1, 0); label.Text = text .. ": " .. fmt(v); tb.Text = tostring(fmt(v)) end
        local function fromInput(i) local pos = math.clamp((i.Position.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1); local v = fmt(minV + pos * (maxV - minV)); upd(v); setValue(v); saveConfig() end
        sliderBg.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true; fromInput(i) end end)
        UserInputService.InputChanged:Connect(function(i) if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then fromInput(i) end end)
        UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
        tb.FocusLost:Connect(function() local n = tonumber(tb.Text); if n then n = math.clamp(n, minV, maxV); upd(n); setValue(n); saveConfig() else tb.Text = tostring(fmt(getValue())) end end)
    end

