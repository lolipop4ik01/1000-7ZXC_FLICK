-- =================== PING + VELOCITY + PREDICT ===================
local function getPingSeconds()
    local ok, v = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    return ok and (v / 1000) or 0
end

local velCache = {}
local function smoothedVelocity(part)
    local raw = part.AssemblyLinearVelocity
    if not Config.VelocitySmooth then return raw end
    local key = tostring(part)
    local now = os.clock()
    local c = velCache[key]
    if not c then c = {}; velCache[key] = c end
    table.insert(c, {v = raw, t = now})
    while #c > 0 and now - c[1].t > 0.1 do table.remove(c, 1) end
    local sum = Vector3.zero
    for _, e in ipairs(c) do sum = sum + e.v end
    return #c > 0 and (sum / #c) or Vector3.zero
end

local function predictedPosition(part)
    if not Config.PredictEnabled then return part.Position end
    local vel = smoothedVelocity(part)
    if vel.Magnitude < 0.05 then return part.Position end
    local offset = Vector3.new(vel.X * Config.PredictXZ, vel.Y * Config.PredictY, vel.Z * Config.PredictXZ)
    if Config.PingComp then
        offset = offset + vel * (getPingSeconds() * 0.5)
    end
    return part.Position + offset
end

-- =================== MURDERER BACKGROUND CACHE ===================
local murdererCache = nil

local function findMurdererOnce()
    if game.PlaceId == 142823291 then
        local ok, data = pcall(function()
            local rf = RS:FindFirstChild("GetPlayerData", true)
            if rf and rf:IsA("RemoteFunction") then return rf:InvokeServer() end
        end)
        if ok and type(data) == "table" then
            for name, info in pairs(data) do
                if type(info) == "table"
                    and tostring(info.Role or ""):lower() == "murderer"
                    and not info.Killed and not info.Dead
                then
                    local p = Players:FindFirstChild(name)
                    if p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        return p
                    end
                end
            end
        end
        return nil
    end
    -- Fallback: knife-holder detection (для форков с подменённым PlaceId)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                for _, c in ipairs(p.Character:GetChildren()) do
                    if c:IsA("Tool") and c.Name == "Knife" then return p end
                end
                local bp = p:FindFirstChild("Backpack")
                if bp and bp:FindFirstChild("Knife") then return p end
            end
        end
    end
    return nil
end

local function startCacheLoop()
    if getgenv()._flickCacheRunning then return end
    getgenv()._flickCacheRunning = true
    task.spawn(function()
        while getgenv()._flickCacheRunning do
            local ok, res = pcall(findMurdererOnce)
            murdererCache = ok and res or nil
            task.wait(Config.CacheInterval)
        end
    end)
end

-- =================== GUN LAYER ===================
local function findGunInCharacter()
    local char = LP.Character
    if not char then return nil end
    for _, c in ipairs(char:GetChildren()) do
        if c:IsA("Tool") and c.Name == "Gun" then return c end
    end
    return nil
end

local function findGunAnywhere()
    local equipped = findGunInCharacter()
    if equipped then return equipped end
    local bp = LP:FindFirstChild("Backpack")
    if bp then
        local g = bp:FindFirstChild("Gun")
        if g and g:IsA("Tool") then return g end
    end
    return nil
end

local function equipGunIfNeeded()
    if findGunInCharacter() then return true end
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    local bp = LP:FindFirstChild("Backpack")
    local g = bp and bp:FindFirstChild("Gun")
    if not (g and g:IsA("Tool")) then return false end
    pcall(function() hum:EquipTool(g) end)
    task.wait(0.08)
    return findGunInCharacter() ~= nil
end

local function unequipGun()
    local gun = findGunInCharacter()
    if not gun then return end
    local bp = LP:FindFirstChild("Backpack")
    if bp then pcall(function() gun.Parent = bp end) end
end

-- =================== SHOOT REMOTE ===================
local function findShootRemote()
    local remotes = RS:FindFirstChild("Remotes")
    if not remotes then return nil end
    local gunFolder = remotes:FindFirstChild("Gun")
    if not gunFolder then return nil end
    local shoot = gunFolder:FindFirstChild("Shoot")
    if shoot and shoot:IsA("RemoteEvent") then return shoot end
    return nil
end

-- =================== FLICK CORE ===================
local firing = false

local function computeCameraCFrame(targetPos)
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    return CFrame.lookAt(cam.CFrame.Position, targetPos)
end

local function visualBodyFlick(targetPos, instant)
    local char = LP.Character
    if not char then return end
    local hum  = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return end

    local flatTarget = Vector3.new(targetPos.X, root.Position.Y, targetPos.Z)
    if (flatTarget - root.Position).Magnitude < 0.5 then return end

    local origCFrame   = root.CFrame
    local targetCFrame = CFrame.lookAt(root.Position, flatTarget)
    local wasAuto = hum.AutoRotate
    hum.AutoRotate = false

    if instant then
        root.CFrame = targetCFrame
        RunService.Heartbeat:Wait()
    else
        local angle = math.acos(math.clamp(origCFrame.LookVector:Dot(targetCFrame.LookVector), -1, 1))
        local totalTime = math.clamp(angle / (math.max(Config.FlickSpeed, 1) * 2), 0.02, 0.4)
        local steps = math.clamp(math.floor(totalTime * 60), 4, 30)
        for i = 1, steps do
            root.CFrame = origCFrame:Lerp(targetCFrame, i / steps)
            RunService.RenderStepped:Wait()
        end
    end

    hum.AutoRotate = wasAuto
end

local function flick()
    if not Config.Enabled then
        notify("Flick disabled.", 1)
        return
    end
    if firing then return end
    firing = true

    local murderer = murdererCache
    if not murderer or not murderer.Parent then
        murderer = findMurdererOnce()
        murdererCache = murderer
    end
    if not murderer or not murderer.Character then
        notify("No murderer cached.", 1)
        firing = false
        return
    end

    local targetRoot = murderer.Character:FindFirstChild("HumanoidRootPart")
    local targetHum  = murderer.Character:FindFirstChildOfClass("Humanoid")
    if not targetRoot or not targetHum or targetHum.Health <= 0 then
        notify("Murderer unavailable.", 1)
        firing = false
        return
    end

    local targetPos = predictedPosition(targetRoot)
    local camCF     = computeCameraCFrame(targetPos)
    if not camCF then firing = false; return end

    if Config.AutoShoot then
        if not findGunAnywhere() then
            notify("No Gun in inventory.", 1)
            firing = false
            return
        end
        if not equipGunIfNeeded() then
            notify("Equip failed.", 1)
            firing = false
            return
        end
        local remote = findShootRemote()
        if not remote then
            notify("Shoot remote not found.", 1)
            firing = false
            return
        end
        pcall(function() remote:FireServer(targetPos, camCF) end)
        if Config.AutoUnequip then unequipGun() end
    end

    task.spawn(function()
        pcall(visualBodyFlick, targetPos, Config.InstantFlick)
        firing = false
    end)
end

-- =================== KEYBIND ===================
local waitingForBind = false
local keyConn = nil

local function setupKeybind()
    if keyConn then keyConn:Disconnect() end
    keyConn = UIS.InputBegan:Connect(function(input, processed)
        if processed then return end
        if waitingForBind then
            waitingForBind = false
            if input.KeyCode ~= Enum.KeyCode.Unknown then
                Config.Keybind = input.KeyCode.Name
                saveConfig()
                notify("Keybind set: " .. Config.Keybind, 1)
            end
            return
        end
        if input.KeyCode == Enum.KeyCode[Config.Keybind] then
            flick()
        end
    end)
end

local function startBind()
    waitingForBind = true
    notify("Press a key to bind...", 3)
    task.delay(3, function()
        if waitingForBind then
            waitingForBind = false
            notify("Bind cancelled.", 1)
        end
    end)
end

