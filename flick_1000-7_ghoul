        local x = math.clamp(abs.X, 0, math.max(vp.X - sz.X, 0))
        local y = math.clamp(abs.Y, 0, math.max(vp.Y - sz.Y, 0))
        circle.Position = UDim2.fromOffset(x, y)
    end
    add(UIS:GetPropertyChangedSignal("TouchEnabled"):Connect(clampCircle))
    clampCircle()

