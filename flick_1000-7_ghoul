local function saveConfig()
    pcall(function()
        if writefile then writefile(CONFIG_FILE, HttpService:JSONEncode(Config)) end
    end)
end

local function loadConfig()
    pcall(function()
        local data
        if readfile and isfile and isfile(CONFIG_FILE) then
            local ok, d = pcall(function() return HttpService:JSONDecode(readfile(CONFIG_FILE)) end)
            if ok and type(d) == "table" then data = d end
        end
        if not data and readfile and isfile then
            for _, legacy in ipairs(LEGACY_CONFIGS) do
                if isfile(legacy) then
                    local ok, d = pcall(function() return HttpService:JSONDecode(readfile(legacy)) end)
                    if ok and type(d) == "table" then
                        data = d
                        print("[FlickV26.1] Migrated from: " .. legacy)
                        break
                    end
                end
            end
        end
        if data then
            for k, v in pairs(data) do if Config[k] ~= nil then Config[k] = v end end
            if writefile then writefile(CONFIG_FILE, HttpService:JSONEncode(Config)) end
        end
    end)
end
