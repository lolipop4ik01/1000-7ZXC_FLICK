-- ========== ПРЕДИКТ ==========
local function getPing()
    local success, ping = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    return success and (ping / 1000) or 0
end

local velocityCache = {}
local function getSmoothedVelocity(part)
    if not Config.VelocitySmooth then return part.AssemblyLinearVelocity end
    local now = tick()
    local key = tostring(part)
    if not velocityCache[key] then velocityCache[key] = {} end
    local cache = velocityCache[key]
    table.insert(cache, {v = part.AssemblyLinearVelocity, t = now})
    while #cache > 0 and now - cache[1].t > 0.1 do table.remove(cache, 1) end
    local avg = Vector3.zero
    for _, entry in ipairs(cache) do avg = avg + entry.v end
    if #cache > 0 then avg = avg / #cache end
    return avg
end

local function getPredictedPosition(part)
    if not part then return nil end
    if not Config.PredictEnabled then return part.Position end
    
    local vel = getSmoothedVelocity(part)
    if not vel then return part.Position end
    
    local multXZ = Config.PredictXZ
    local multY = Config.PredictY
    
    -- Для HRP отключаем вертикальный предикт, чтобы держать идеальный центр
    if part.Name == "HumanoidRootPart" then
        multY = 0
    end
    
    if Config.PredictOp == "Divide" then
        if multXZ > 0 then multXZ = 1 / multXZ else multXZ = 0 end
        if multY > 0 then multY = 1 / multY else multY = 0 end
    end
    
    local offset = Vector3.new(vel.X * multXZ, vel.Y * multY, vel.Z * multXZ)
    
    if Config.PingComp then
        local ping = getPing()
        local pingOffset = vel * (ping * 0.5)
        if part.Name == "HumanoidRootPart" then
            pingOffset = Vector3.new(pingOffset.X, 0, pingOffset.Z)
        end
        offset = offset + pingOffset
    end
    
    return part.Position + offset
end

