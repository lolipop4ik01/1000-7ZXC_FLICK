        local function setFromInput(input)
            local absX = bg.AbsolutePosition.X
            local absW = bg.AbsoluteSize.X
            local rel = math.clamp((input.Position.X - absX) / absW, 0, 1)
            local raw = min + rel * (max - min)
            local snapped = math.floor(raw / step + 0.5) * step
            snapped = math.clamp(snapped, min, max)
            Config[key] = snapped
            render()
        end

        bg.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                setFromInput(input)
            end
        end)
        UIS.InputChanged:Connect(function(input)
            if not dragging then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
                setFromInput(input)
            end
        end)
        UIS.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                if dragging then
                    dragging = false
                    Save()
                end
            end
        end)

        box.FocusLost:Connect(function()
            local n = tonumber(box.Text)
            if n then
                n = math.clamp(n, min, max)
                local snapped = math.floor(n / step + 0.5) * step
                Config[key] = snapped
                Save()
            end
            render()
        end)
    end

    local function button(label, onClick, color)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 32)
        btn.BackgroundColor3 = color or Color3.fromRGB(40, 40, 50)
        btn.BorderSizePixel = 0
        btn.AutoButtonColor = false
        btn.Text = label
        btn.TextColor3 = Color3.fromRGB(235, 235, 240)
        btn.Font = Enum.Font.GothamMedium
        btn.TextSize = 12
        btn.Parent = scroll
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 7)
        btn.MouseButton1Click:Connect(onClick)
        return btn
    end

    -- ---------- LAYOUT ----------
    section("CORE")
    toggle("Enable Flick", "Enabled")
    toggle("Instant Flick", "InstantFlick")
    slider("Flick Speed", "FlickSpeed", 1, 240, false, 1)

    section("SHOOT")
    toggle("Auto Shoot", "AutoShoot")
    toggle("Auto Unequip After Shot", "AutoUnequip")

    section("AIM PREDICT")
    toggle("Predict", "PredictEnabled")
    toggle("Ping Compensation", "PingComp")
    toggle("Velocity Smoothing", "VelocitySmooth")
    slider("Predict X/Z", "PredictXZ", 0.0, 0.5, true, 0.001)
    slider("Predict Y",   "PredictY",  0.0, 0.2, true, 0.001)

    section("SYSTEM")
    toggle("Notifications", "Notifications")
    slider("Cache Interval (s)", "CacheInterval", 0.25, 5.0, true, 0.05)

    local bindBtn = button("⌨️ BIND: " .. Config.Keybind, function()
        bindBtn.Text = "⌨️ PRESS A KEY..."
        StartBind()
        task.delay(3.2, function()
            bindBtn.Text = "⌨️ BIND: " .. Config.Keybind
        end)
    end, Color3.fromRGB(55, 50, 40))

    button("👁 Hide GUI", function()
        frame.Visible = false
    end)

    button("💀 Unload", function()
        getgenv()._flickCacheRunning = false
        pcall(function() gui:Destroy() end)
        Notify("Unloaded.", 2)
    end, Color3.fromRGB(70, 40, 40))

    -- ---------- OPEN/CLOSE ----------
    circle.MouseButton1Click:Connect(function()
        frame.Visible = not frame.Visible
    end)

    return gui
end

