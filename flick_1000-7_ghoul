        btn.TextColor3 = Color3.new(1, 1, 1); btn.Font = Enum.Font.Jura; btn.TextSize = 14; btn.Text = text
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
        btn.MouseButton1Click:Connect(callback)
        return btn
    end
    
    local function addSection(title)
        local section = Instance.new("TextLabel", Container)
        section.Size = UDim2.new(1, 0, 0, 25); section.BackgroundTransparency = 1
        section.Text = "─── " .. title .. " ───"; section.TextColor3 = Color3.fromRGB(255, 150, 150)
        section.Font = Enum.Font.Jura; section.TextSize = 12
    end
    
    -- UI ЭЛЕМЕНТЫ
    addSection("ОСНОВНЫЕ")
    addToggle("🔘 FLICK", function() return Config.Enabled end, function(v) Config.Enabled = v end)
    addToggle("⚡ INSTANT FLICK", function() return Config.InstantFlick end, function(v) Config.InstantFlick = v end)
    addSlider("🎚️ FLICK SPEED", 1, 200, function() return Config.FlickSpeed end, function(v) Config.FlickSpeed = v end)
    
    addSection("ЦЕЛЬ")
    addToggle("🎲 RANDOM BODY PART", function() return Config.RandomBodyPart end, function(v) Config.RandomBodyPart = v end)
    addToggle("🔫 AUTO SHOOT", function() return Config.AutoShoot end, function(v) Config.AutoShoot = v end)

    addSection("AIM PREDICT")
    addToggle("🎯 AIM PREDICT", function() return Config.PredictEnabled end, function(v) Config.PredictEnabled = v end)
    addToggle("📡 PING COMPENSATION", function() return Config.PingComp end, function(v) Config.PingComp = v end)
    addToggle("🌊 VELOCITY SMOOTHING", function() return Config.VelocitySmooth end, function(v) Config.VelocitySmooth = v end)
    
    local predictOpBtn = addButton("⚙️ PREDICT OP: " .. Config.PredictOp, function()
        Config.PredictOp = Config.PredictOp == "Multiply" and "Divide" or "Multiply"
        predictOpBtn.Text = "⚙️ PREDICT OP: " .. Config.PredictOp
        saveConfig(); notify("Predict Op: " .. Config.PredictOp, 1)
    end)
    addSlider("↔️ PREDICT X/Z", 0.001, 1.0, function() return Config.PredictXZ end, function(v) Config.PredictXZ = v end, true)
    addSlider("↕️ PREDICT Y", 0.001, 1.0, function() return Config.PredictY end, function(v) Config.PredictY = v end, true)
    
    addSection("ВОЗВРАТ КАМЕРЫ")
    addToggle("🔄 RETURN CAMERA", function() return Config.ReturnCamera end, function(v) Config.ReturnCamera = v end)
    addSlider("🎯 RETURN SPEED", 1, 200, function() return Config.ReturnSpeed end, function(v) Config.ReturnSpeed = v end)
    addSlider("🎲 RANDOM X %", 0, 100, function() return Config.ReturnRandomnessX end, function(v) Config.ReturnRandomnessX = v end)
    addSlider("🎲 RANDOM Y %", 0, 100, function() return Config.ReturnRandomnessY end, function(v) Config.ReturnRandomnessY = v end)
    addSlider("⏱️ DELAY MS", 0, 50, function() return Config.ReturnDelay end, function(v) Config.ReturnDelay = v end)
    
    addSection("КНОПКИ")
    addToggle("🔘 SHOW BIG BUTTON", function() return BigButton and BigButton.Visible end, function(v)
        if v then if not BigButton then CreateBigButton() else BigButton.Visible = true end elseif BigButton then BigButton.Visible = false end
    end)
    addToggle("🎨 SHOW BIND BUTTON", function() return BindButton and BindButton.Visible end, function(v)
        if v then if not BindButton then CreateBindButton() else BindButton.Visible = true end elseif BindButton then BindButton.Visible = false end
    end)
    
    local bindBtn = Instance.new("TextButton", Container)
    bindBtn.Size = UDim2.new(1, 0, 0, 35); bindBtn.BackgroundColor3 = Color3.fromRGB(80, 70, 50)
    bindBtn.TextColor3 = Color3.new(1, 1, 1); bindBtn.Font = Enum.Font.Jura; bindBtn.TextSize = 14
    bindBtn.Text = "⌨️ SET KEYBIND: " .. Config.Keybind
    Instance.new("UICorner", bindBtn).CornerRadius = UDim.new(0, 6)
    bindBtn.MouseButton1Click:Connect(function()
        waitingForBind = true; bindBtn.Text = "⌨️ PRESS ANY KEY..."
        task.wait(3)
        if waitingForBind then waitingForBind = false; bindBtn.Text = "⌨️ SET KEYBIND: " .. Config.Keybind end
    end)
    
    addButton("🔄 RESET BIG BUTTON POS", function()
        Config.BigButtonPos = {xs = 0.5, xo = 0, ys = 0.5, yo = 0}
        if BigButton then BigButton.Position = UDim2.new(0.5, 0, 0.5, 0) end
        saveConfig(); notify("Big button position reset", 1)
    end)
    addButton("🔄 RESET BIND BUTTON POS", function()
        Config.BindButtonPos = {xs = 0.1, xo = 0, ys = 0.9, yo = 0}
        if BindButton then BindButton.Position = UDim2.new(0.1, 0, 0.9, 0) end
        saveConfig(); notify("Bind button position reset", 1)
    end)
    addButton("👁️ HIDE GUI", function() MainFrame.Visible = false; notify("GUI hidden", 2) end)
    addButton("💀 DESTROY ALL", function()
        pcall(function() MainGui:Destroy() end)
        pcall(function() if BigButton then BigButton.Parent:Destroy() end end)
        pcall(function() if BindButton then BindButton.Parent:Destroy() end end)
        MainGui, MainFrame, CircleButton, BigButton, BindButton = nil, nil, nil, nil, nil
        notify("All GUI destroyed", 2)
    end)
    
    CircleButton.MouseButton1Click:Connect(function() if MainFrame then MainFrame.Visible = not MainFrame.Visible end end)
end

