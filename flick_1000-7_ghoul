    W.slider(scroll, "Predict Y",   "PredictY",  0.0, 0.2, true, 0.001)

    W.section(scroll, "SYSTEM")
    W.toggle(scroll, "Notifications", "Notifications")
    W.toggle(scroll, "Debug Hook (log FireServer args)", "DebugHook")
    W.slider(scroll, "Cache Interval (s)", "CacheInterval", 0.25, 5.0, true, 0.05)

    -- ---------- ACTIONS ----------
    W.section(scroll, "ACTIONS")

    W.button(scroll, "🎯 FLICK NOW", function()
        task.spawn(Flick)
    end, Color3.fromRGB(60, 80, 60))

    -- [6] Debug Shot: пробный выстрел + полный вывод аргументов в F9
    W.button(scroll, "🐞 DEBUG SHOT (log args)", function()
        task.spawn(function()
            local shot, reason = ComputeShot()
            if not shot then
                print(("[FlickV5-DebugShot] aborted: %s"):format(tostring(reason)))
                Notify("Debug Shot: " .. tostring(reason), 2)
                return
            end

            local remote = shot.remote or ResolveRemote()
            if not remote then
                print("[FlickV5-DebugShot] no shoot remote found")
                Notify("Debug Shot: no remote", 2)
                return
            end

            print("=================================================")
            print("[FlickV5-DebugShot] remote: " .. remote:GetFullName())
            print(("[FlickV5-DebugShot] target: %s (HRP at %s)")
                :format(shot.murderer.Name, tostring(shot.targetPos)))
            print("[FlickV5-DebugShot] firing signature (camCF, targetPos):")
            print(("  arg[1] = (CFrame)  %s"):format(tostring(shot.camCF)))
            print(("  arg[2] = (Vector3) %s"):format(tostring(shot.targetPos)))

            -- пробуем (camCF, targetPos) — основная сигнатура
            local ok = pcall(function()
                remote:FireServer(shot.camCF, shot.targetPos)
            end)
            print(("[FlickV5-DebugShot] FireServer (camCF, targetPos) -> %s")
                :format(ok and "sent" or "error"))

            -- пробуем (targetPos, camCF) — альтернативный порядок
            if Config.DebugHook then
                task.wait(0.1)
                local ok2 = pcall(function()
                    remote:FireServer(shot.targetPos, shot.camCF)
                end)
                print(("[FlickV5-DebugShot] FireServer (targetPos, camCF) -> %s")
                    :format(ok2 and "sent" or "error"))
                print("[FlickV5-DebugShot] Проверь F9: какой из двух зашёл — тот и порядок.")
            end

            print("[FlickV5-DebugShot] Смотри F9 — все события FireServer должны быть видны (при DebugHook=on).")
            print("=================================================")
            Notify("Debug Shot fired. See F9.", 2)
        end)
    end, Theme.debug)

    local bindBtn = W.button(scroll,
        "⌨️ BIND: " .. Config.Keybind,
        function()
            bindBtn.Text = "⌨️ PRESS A KEY..."
            StartBind()
            task.delay(3.2, function()
                if bindBtn and bindBtn.Parent then
                    bindBtn.Text = "⌨️ BIND: " .. Config.Keybind
                end
            end)
        end,
        Color3.fromRGB(55, 50, 40))

    -- ---------- CACHE STATUS ----------
    local cacheLabel = Instance.new("TextLabel")
    cacheLabel.Size = UDim2.new(1, 0, 0, 22)
    cacheLabel.BackgroundTransparency = 1
    cacheLabel.Text = "cache: —"
    cacheLabel.TextColor3 = Theme.textDim
    cacheLabel.Font = Enum.Font.Gotham
    cacheLabel.TextSize = 11
    cacheLabel.TextXAlignment = Enum.TextXAlignment.Left
