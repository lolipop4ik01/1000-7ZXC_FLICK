end

local function disconnectAll()
    if getgenv()._flickV5Token == INSTANCE_TOKEN then
        getgenv()._flickV5Token = nil
    end
    for _, c in ipairs(activeConnections) do
        pcall(function() c:Disconnect() end)
    end
    activeConnections = {}
    pcall(function()
        local sg = PLAYER_GUI:FindFirstChild("FlickNotifyV5")
        if sg then sg:Destroy() end
