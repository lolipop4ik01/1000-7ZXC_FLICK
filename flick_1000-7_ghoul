local function getPing()
    local ok, ping = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
    return (ok and ping and ping > 0) and (ping / 1000) or 0
end

-- ========== VELOCITY ==========
local velocityCache = {}
local function getSmoothedVelocity(part)
    if not Config.VelocitySmooth then return part.AssemblyLinearVelocity end
    local now = tick(); local key = tostring(part)
    if not velocityCache[key] then velocityCache[key] = {} end
    local cache = velocityCache[key]
    table.insert(cache, {v = part.AssemblyLinearVelocity, t = now})
    while #cache > 0 and now - cache[1].t > 0.06 do table.remove(cache, 1) end
    if #cache == 0 then return part.AssemblyLinearVelocity end
    local totalW, acc = 0, Vector3.zero
    for i, entry in ipairs(cache) do
        local w = i * i; acc = acc + entry.v * w; totalW = totalW + w
    end
    return acc / totalW
end

local function getIntentVelocity(part)
    local smoothed = getSmoothedVelocity(part)
    if smoothed.Magnitude > 5 then return smoothed end
    local char = part.Parent; local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum and hum.MoveDirection.Magnitude > 0 then return hum.MoveDirection * hum.WalkSpeed end
    return smoothed
end

local function isAirborne(part)
    local char = part.Parent
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    local state = hum:GetState()
    return state == Enum.HumanoidStateType.Freefall
        or state == Enum.HumanoidStateType.Jumping
        or state == Enum.HumanoidStateType.FallingDown
end

-- ========== PREDICT ==========
local function computeTargetPosition(part)
    if not part then return nil end
    local vel = getIntentVelocity(part)
    if not vel then return part.Position end

    local serverOffset = Vector3.zero
    if Config.ServerSidePredict then
        local ping = getPing()
        serverOffset = vel * (ping * 0.5)
    end

    local predictOffset = Vector3.zero
    if Config.PredictEnabled then
        local multXZ = Config.PredictXZ
        local multY = Config.PredictY
        if Config.PredictOp == "Divide" then
            if multXZ > 0 then multXZ = 1 / multXZ end
            if multY > 0 then multY = 1 / multY end
        end

        local predX = vel.X * multXZ
        local predZ = vel.Z * multXZ
        local predY

        if Config.GravityPredict and isAirborne(part) then
            local t = multY
            predY = vel.Y * t - 0.5 * GRAVITY * t * t
        else
            predY = vel.Y * multY
        end

        predictOffset = Vector3.new(predX, predY, predZ)
    end

    local legacyPing = Vector3.zero
    if Config.PingComp then
        local ping = getPing()
        legacyPing = vel * (ping * 0.5)
    end

    return part.Position + serverOffset + predictOffset + legacyPing
end

-- ========== GLOBAL CAMERA STATE ==========
local camState = {
    locked = false,
    originalType = nil,
    originalSubject = nil,
    autoRotateLocked = false,
    originalAutoRotate = nil,
    session = false,
}

local lastCameraCFrame = nil
local lastCameraRootPos = nil
local returnToken = 0
local flickLerpToken = 0

local function lockCamState(cam, hum)
    if not camState.locked and cam then
        camState.locked = true
        camState.originalType = cam.CameraType
        camState.originalSubject = cam.CameraSubject
        cam.CameraType = Enum.CameraType.Scriptable
    end
    if not camState.autoRotateLocked and hum then
        camState.autoRotateLocked = true
        camState.originalAutoRotate = hum.AutoRotate
        hum.AutoRotate = false
    end
end

local function unlockCamState(cam, hum)
    if camState.locked then
        camState.locked = false
        if cam and cam.Parent then
            if camState.originalType then cam.CameraType = camState.originalType end
            if camState.originalSubject then cam.CameraSubject = camState.originalSubject end
        end
        camState.originalType = nil
        camState.originalSubject = nil
    end
    if camState.autoRotateLocked then
        camState.autoRotateLocked = false
        if hum and hum.Parent and camState.originalAutoRotate ~= nil then
            hum.AutoRotate = camState.originalAutoRotate
        end
        camState.originalAutoRotate = nil
    end
end

