local waitingForBind = false
local keyConn = nil

local function setupKeybind()
    if keyConn then keyConn:Disconnect() end
    keyConn = UIS.InputBegan:Connect(function(input, processed)
        if processed then return end
        if waitingForBind then
            waitingForBind = false
            if input.KeyCode ~= Enum.KeyCode.Unknown then
                Config.Keybind = input.KeyCode.Name
                saveConfig()
                notify("Keybind set: " .. Config.Keybind, 1)
            end
            return
        end
        if input.KeyCode == Enum.KeyCode[Config.Keybind] then
            flick()
        end
    end)
end

local function startBind()
    waitingForBind = true
    notify("Press a key to bind...", 3)
    task.delay(3, function()
        if waitingForBind then
            waitingForBind = false
            notify("Bind cancelled.", 1)
        end
    end)
end

