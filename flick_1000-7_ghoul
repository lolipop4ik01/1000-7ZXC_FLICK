local function getPing()
    local ok, ping = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
    return (ok and ping and ping > 0) and (ping / 1000) or 0
end

local velocityCache = {}
local function getSmoothedVelocity(part)
    if not Config.VelocitySmooth then return part.AssemblyLinearVelocity end
    local now = tick(); local key = tostring(part)
    if not velocityCache[key] then velocityCache[key] = {} end
    local cache = velocityCache[key]
    table.insert(cache, {v = part.AssemblyLinearVelocity, t = now})
    while #cache > 0 and now - cache[1].t > 0.06 do table.remove(cache, 1) end
    if #cache == 0 then return part.AssemblyLinearVelocity end
    local totalW, acc = 0, Vector3.zero
    for i, entry in ipairs(cache) do
        local w = i * i; acc = acc + entry.v * w; totalW = totalW + w
    end
    return acc / totalW
end

local function computeTargetPosition(part)
    if not part then return nil end
    local vel = getSmoothedVelocity(part)
    
    local serverOffset = Vector3.zero
    if Config.ServerSidePredict then serverOffset = vel * (getPing() * 0.5) end

    local predictOffset = Vector3.zero
    if Config.PredictEnabled then
        local multXZ = Config.PredictXZ
        local multY = Config.PredictY
        if Config.PredictOp == "Divide" then
            if multXZ > 0 then multXZ = 1 / multXZ end
            if multY > 0 then multY = 1 / multY end
        end
        local predX = vel.X * multXZ
        local predZ = vel.Z * multXZ
        local predY = 0
        
        local hum = part.Parent and part.Parent:FindFirstChildOfClass("Humanoid")
        local state = hum and hum:GetState()
        local airborne = state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.Jumping
        
        if Config.GravityPredict and airborne then
            local t = multY
            predY = vel.Y * t - 0.5 * GRAVITY * t * t
        else
            predY = vel.Y * multY
        end
        predictOffset = Vector3.new(predX, predY, predZ)
    end
    return part.Position + serverOffset + predictOffset
end

function findMurderer()
    if game.PlaceId == 142823291 then
        local success, roleData = pcall(function() local remote = ReplicatedStorage:FindFirstChild("GetPlayerData", true); if remote and remote:IsA("RemoteFunction") then return remote:InvokeServer() end end)
        if success and roleData then
            for playerName, data in pairs(roleData) do
                if data.Role == "Murderer" and not data.Killed and not data.Dead then local p = Players:FindFirstChild(playerName); if p then return p end end
            end
        end
        return nil
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character; local root = char:FindFirstChild("HumanoidRootPart"); local hum = char:FindFirstChild("Humanoid")
            if root and hum and hum.Health > 0 then
                if player:FindFirstChild("Backpack") and player.Backpack:FindFirstChild("Knife") then return player end
                for _, tool in ipairs(char:GetChildren()) do if tool:IsA("Tool") and tool.Name == "Knife" then return player end end
            end
        end
    end
    return nil
end

local function fireOnce(targetPos)
    local cam = workspace.CurrentCamera
    if not cam then return end
    
    local remote = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Gun") and ReplicatedStorage.Remotes.Gun:FindFirstChild("Shoot")
    if remote then
        pcall(function() remote:FireServer(targetPos) end)
        pcall(function() remote:FireServer({ cam.CFrame, CFrame.new(targetPos) }) end)
    end
    
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local gun = char:FindFirstChild("Gun") or (backpack and backpack:FindFirstChild("Gun"))
    
    if gun and gun:IsA("Tool") and hum then
        if gun.Parent ~= char then 
            pcall(function() hum:EquipTool(gun) end)
            task.wait(0.02) 
        end
        pcall(function() gun:Activate() end)
        pcall(function() 
            local vu = game:GetService("VirtualUser")
            vu:Button1Down(Vector2.zero)
            vu:Button1Up(Vector2.zero) 
        end)
        
        if Config.AutoUnequip then
            task.delay(0.15, function()
                if gun and gun.Parent == char and hum then
                    pcall(function() hum:UnequipTools() end)
                end
            end)
        end
    end
end

-- УПРОЩЕННАЯ И СТАБИЛЬНАЯ ЛОГИКА КАМЕРЫ
local flickToken = 0
local savedCamCFrame = nil
local savedRootPos = nil
local currentCameraTween = nil

local function resetCamera()
    local cam = workspace.CurrentCamera
    if currentCameraTween then currentCameraTween:Cancel() end
    cam.CameraType = Enum.CameraType.Custom
    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if hum then cam.CameraSubject = hum end
end

function flickToMurderer()
    if not Config.Enabled then notify("Flick disabled!", 1) return end
    local murderer = findMurderer()
    if not murderer or not murderer.Character then notify("Murderer not found!", 1) return end

    local cam = workspace.CurrentCamera
    local char = LocalPlayer.Character
    if not char then return end
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not rootPart or not hum then return end

    local targetPart = murderer.Character:FindFirstChild(Config.TargetPart) or murderer.Character:FindFirstChild("HumanoidRootPart")
    if not targetPart then return end

    -- Сохраняем камеру только при первом флике
    if not savedCamCFrame then
        savedCamCFrame = cam.CFrame
        savedRootPos = rootPart.Position
    end

    local targetPos = computeTargetPosition(targetPart)
    if not targetPos then return end

    -- Поворот тела (опционально, на 1 кадр)
    if Config.RotateBody then
        local dir = Vector3.new(targetPos.X, rootPart.Position.Y, targetPos.Z) - rootPart.Position
        if dir.Magnitude > 0.01 then
            rootPart.CFrame = CFrame.lookAt(rootPart.Position, rootPart.Position + dir.Unit)
        end
    end

    -- НАСТРОЙКА КАМЕРЫ
    if currentCameraTween then currentCameraTween:Cancel() end
    cam.CameraType = Enum.CameraType.Scriptable
    
    local headPos = char:FindFirstChild("Head") and char.Head.Position or rootPart.Position
    local isFirstPerson = (cam.CFrame.Position - headPos).Magnitude < 5
    local newCamCFrame

    if isFirstPerson then
        newCamCFrame = CFrame.lookAt(cam.CFrame.Position, targetPos)
    else
        local camOffset = cam.CFrame.Position - rootPart.Position
        local distance = Vector3.new(camOffset.X, 0, camOffset.Z).Magnitude
        local height = camOffset.Y
        local behindDir = -(Vector3.new(targetPos.X, rootPart.Position.Y, targetPos.Z) - rootPart.Position).Unit
        local newCamPos = rootPart.Position + behindDir * distance + Vector3.new(0, height, 0)
        newCamCFrame = CFrame.lookAt(newCamPos, targetPos)
    end

    flickToken = flickToken + 1
    local myToken = flickToken

    -- ДВИЖЕНИЕ КАМЕРЫ (Мгновенно или Tween)
    if Config.InstantFlick or Config.FlickSpeed >= 200 then
        cam.CFrame = newCamCFrame
    else
        local travelTime = math.clamp(1 / (Config.FlickSpeed / 100), 0.01, 0.5)
        currentCameraTween = TweenService:Create(cam, TweenInfo.new(travelTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {CFrame = newCamCFrame})
        currentCameraTween:Play()
        currentCameraTween.Completed:Wait()
    end

    if myToken ~= flickToken then return end

    -- СИНХРОНИЗАЦИЯ И ВЫСТРЕЛ
    if Config.ReplicationSync then RunService.Heartbeat:Wait() end
    
    if Config.AutoShoot then
        local tp = murderer.Character and (murderer.Character:FindFirstChild(Config.TargetPart) or murderer.Character:FindFirstChild("HumanoidRootPart"))
        local p = tp and computeTargetPosition(tp)
        if p then
            cam.CFrame = CFrame.lookAt(cam.CFrame.Position, p)
            fireOnce(p)
        end
    end

    -- ВОЗВРАТ КАМЕРЫ
    if Config.ReturnCamera then
        task.delay(Config.ReturnDelay / 1000, function()
            if myToken ~= flickToken then return end -- Если был новый флик, прерываемся
            
            local targetCF = savedCamCFrame
            local currentRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if currentRoot and savedRootPos then
                local off = targetCF.Position - savedRootPos
                targetCF = CFrame.new(currentRoot.Position + off) * (targetCF - targetCF.Position)
            end
            
            -- Случайный сдвиг
            local randX = (math.random() - 0.5) * 2 * (Config.ReturnRandomnessX / 100)
            local randY = (math.random() - 0.5) * 2 * (Config.ReturnRandomnessY / 100)
            local newLook = (targetCF.LookVector + targetCF.RightVector * randX + targetCF.UpVector * randY).Unit
            targetCF = CFrame.lookAt(targetCF.Position, targetCF.Position + newLook)

            if currentCameraTween then currentCameraTween:Cancel() end
            local returnTime = math.clamp(1 / (Config.ReturnSpeed / 100), 0.05, 0.5)
            currentCameraTween = TweenService:Create(cam, TweenInfo.new(returnTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {CFrame = targetCF})
            currentCameraTween:Play()
            currentCameraTween.Completed:Wait()

            if myToken == flickToken then
                resetCamera()
                savedCamCFrame = nil
                savedRootPos = nil
            end
        end)
    else
        task.delay(0.05, function()
            if myToken == flickToken then
                resetCamera()
                savedCamCFrame = nil
                savedRootPos = nil
            end
        end)
    end
end

-- ========== KEYBIND ==========
local waitingForBind = false
local function setupKeybind()
    if getgenv().KeybindConnection then pcall(function() getgenv().KeybindConnection:Disconnect() end) end
    getgenv().KeybindConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if waitingForBind then
            waitingForBind = false
            if input.KeyCode ~= Enum.KeyCode.Unknown then Config.Keybind = input.KeyCode.Name; saveConfig(); notify("Keybind: " .. Config.Keybind, 1) end
            return
        end
        if input.KeyCode == Enum.KeyCode[Config.Keybind] then task.spawn(flickToMurderer) end
    end)
end

