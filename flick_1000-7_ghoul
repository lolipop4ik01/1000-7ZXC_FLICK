    box.TextSize = 12
    box.ClearTextOnFocus = false
    box.Parent = wrap
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 5)

    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(1, -24, 0, 6)
    bg.Position = UDim2.new(0, 12, 1, -14)
    bg.BackgroundColor3 = Theme.sliderBg
    bg.BorderSizePixel = 0
    bg.Parent = wrap
    Instance.new("UICorner", bg).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = Theme.accent
    fill.BorderSizePixel = 0
    fill.Parent = bg
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local function fmt(v)
        if isFloat then
            return (string.format("%.3f", v):gsub("0+$", ""):gsub("%.$", ""))
        end
        return tostring(math.floor(v))
    end

    local function render()
        local v = Config[key]
        local alpha = math.clamp((v - minV) / (maxV - minV), 0, 1)
        fill.Size = UDim2.new(alpha, 0, 1, 0)
        name.Text = label
        box.Text = fmt(v)
    end
    render()

    local dragging = false
    local function setFromInput(input)
        local absX, absW = bg.AbsolutePosition.X, bg.AbsoluteSize.X
        if absW <= 0 then return end
        local rel = math.clamp((input.Position.X - absX) / absW, 0, 1)
        local raw = minV + rel * (maxV - minV)
        local snapped = math.floor(raw / step + 0.5) * step
        Config[key] = math.clamp(snapped, minV, maxV)
        render()
    end

    bg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setFromInput(input)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            setFromInput(input)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                dragging = false
                Save()
            end
        end
    end)

    box.FocusLost:Connect(function()
        local n = tonumber(box.Text)
        if n then
            n = math.clamp(n, minV, maxV)
            Config[key] = math.floor(n / step + 0.5) * step
            Save()
        end
        render()
    end)

    return wrap
end

function W.button(scroll, label, onClick, color)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 32)
    btn.BackgroundColor3 = color or Color3.fromRGB(40, 40, 50)
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = false
    btn.Text = label
    btn.TextColor3 = Theme.text
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 12
    btn.Parent = scroll
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 7)

    btn.MouseEnter:Connect(function()
        btn.BackgroundColor3 = btn.BackgroundColor3:Lerp(Color3.new(1, 1, 1), 0.06)
    end)
    btn.MouseLeave:Connect(function()
        btn.BackgroundColor3 = color or Color3.fromRGB(40, 40, 50)
    end)
    btn.MouseButton1Click:Connect(onClick)
    return btn
end

