local DragSystem = {}
function DragSystem.MakeDraggable(gui, dragArea)
    local dragging, dragStart, startPos = false, nil, nil
    dragArea.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true; dragStart = input.Position; startPos = gui.Position end end)
    dragArea.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 and dragging then dragging = false end end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart; gui.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

function findMurderer()
    if game.PlaceId == 142823291 then
        local success, roleData = pcall(function() local remote = ReplicatedStorage:FindFirstChild("GetPlayerData", true); if remote and remote:IsA("RemoteFunction") then return remote:InvokeServer() end end)
        if success and roleData then
            for playerName, data in pairs(roleData) do
                if data.Role == "Murderer" and not data.Killed and not data.Dead then local p = Players:FindFirstChild(playerName); if p then return p end end
            end
        end
        return nil
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character; local root = char:FindFirstChild("HumanoidRootPart"); local hum = char:FindFirstChild("Humanoid")
            if root and hum and hum.Health > 0 then
                if player:FindFirstChild("Backpack") and player.Backpack:FindFirstChild("Knife") then return player end
                for _, tool in ipairs(char:GetChildren()) do if tool:IsA("Tool") and tool.Name == "Knife" then return player end end
            end
        end
    end
    return nil
end

local function findShootRemote()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if not remotes then return nil end
    local gunFolder = remotes:FindFirstChild("Gun")
    if not gunFolder then return nil end
    return gunFolder:FindFirstChild("Shoot")
end

local function fireOnce(targetPos)
    local cam = workspace.CurrentCamera
    if not cam then return end

    local remote = findShootRemote()
    if remote then
        pcall(function() remote:FireServer(targetPos) end)
        pcall(function() remote:FireServer(CFrame.new(targetPos)) end)
        pcall(function() remote:FireServer({ cam.CFrame, CFrame.new(targetPos) }) end)
    end

    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local gun = char:FindFirstChild("Gun") or (backpack and backpack:FindFirstChild("Gun"))
    
    if gun and gun:IsA("Tool") and hum then
        if gun.Parent ~= char then 
            pcall(function() hum:EquipTool(gun) end)
            RunService.Heartbeat:Wait() -- Даем 1 кадр на экипировку
        end
        pcall(function() gun:Activate() end)
        pcall(function() 
            local vu = game:GetService("VirtualUser")
            vu:Button1Down(Vector2.zero)
            vu:Button1Up(Vector2.zero) 
        end)
        
        if Config.AutoUnequip then
            task.delay(0.3, function() -- Увеличил задержку до 0.3с, чтобы сервер успел засчитать выстрел
                if gun and gun.Parent == char and hum then
                    pcall(function() hum:UnequipTools() end)
                    local bp = LocalPlayer:FindFirstChild("Backpack")
                    if bp and gun.Parent == char then pcall(function() gun.Parent = bp end) end
                end
            end)
        end
    end
end

