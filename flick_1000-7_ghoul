local function getSafeParent()
    if gethui and typeof(gethui()) == "Instance" then return gethui() end
    if typeof(CoreGui) == "Instance" then return CoreGui end
    return LocalPlayer:WaitForChild("PlayerGui")
end

local function notify(msg, dur)
    if not Config.NotificationsEnabled then return end
    pcall(function()
        local sg = getSafeParent():FindFirstChild("FlickNotif") or Instance.new("ScreenGui")
        sg.Name = "FlickNotif"; sg.ResetOnSpawn = false; sg.IgnoreGuiInset = true; sg.Parent = getSafeParent()
        local f = Instance.new("Frame", sg)
        f.Size = UDim2.new(0, 250, 0, 40); f.Position = UDim2.new(0.5, -125, 0.8, 0)
        f.BackgroundColor3 = Color3.fromRGB(25, 25, 25); f.BackgroundTransparency = 0.2; f.BorderSizePixel = 0
        Instance.new("UICorner", f).CornerRadius = UDim.new(0, 8)
        local l = Instance.new("TextLabel", f)
        l.Size = UDim2.new(1, 0, 1, 0); l.BackgroundTransparency = 1; l.Text = msg; l.TextColor3 = Color3.new(1, 1, 1)
        l.Font = Enum.Font.Jura; l.TextSize = 14
        f:TweenPosition(UDim2.new(0.5, -125, 0.75, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.3, true)
        task.wait(dur or 2)
        f:TweenPosition(UDim2.new(0.5, -125, 0.85, 0), Enum.EasingDirection.In, Enum.EasingStyle.Quad, 0.3, true)
        task.wait(0.3); f:Destroy()
    end)
end

local function getPing()
    local ok, v = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
    return (ok and v and v > 0) and (v / 1000) or 0
end

local function makeDraggable(frame, dragArea)
    dragArea = dragArea or frame
    local dragging, dragStart, startPos = false, nil, nil
    dragArea.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = frame.Position
        end
    end)
    dragArea.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

local velCache = {}
local function computeTargetPosition(part)
    if not part then return nil end
    local vel = part.AssemblyLinearVelocity
    if Config.VelocitySmooth then
        local now = tick(); local key = tostring(part)
        if not velCache[key] then velCache[key] = {} end
        local cache = velCache[key]
        table.insert(cache, {v = vel, t = now})
        while #cache > 0 and now - cache[1].t > 0.06 do table.remove(cache, 1) end
        local tot, acc = 0, Vector3.zero
        for i, e in ipairs(cache) do local w = i * i; acc = acc + e.v * w; tot = tot + w end
        if tot > 0 then vel = acc / tot end
    end
    
    local off = Vector3.zero
    if Config.ServerSidePredict then off = off + vel * (getPing() * 0.5) end
    if Config.PredictEnabled then
        local mxz, my = Config.PredictXZ, Config.PredictY
        if Config.PredictOp == "Divide" then
            if mxz > 0 then mxz = 1 / mxz end
            if my > 0 then my = 1 / my end
        end
        local py = 0
        local hum = part.Parent and part.Parent:FindFirstChildOfClass("Humanoid")
        local state = hum and hum:GetState()
        local airborne = state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.Jumping
        
        if Config.GravityPredict and airborne then py = vel.Y * my - 0.5 * GRAVITY * my * my
        else py = vel.Y * my end
        off = off + Vector3.new(vel.X * mxz, py, vel.Z * mxz)
    end
    return part.Position + off
end

local function isWallBlocked(targetPos)
    local char = LocalPlayer.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {char}
    return workspace:Raycast(hrp.Position, targetPos - hrp.Position, params) ~= nil
end

local function findMurderer()
    if game.PlaceId == 142823291 then
        local ok, data = pcall(function()
            local r = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
            if r and r:IsA("RemoteFunction") then return r:InvokeServer() end
        end)
        if ok and data then
            for name, info in pairs(data) do
                if info.Role == "Murderer" and not info.Killed and not info.Dead then
                    local p = Players:FindFirstChild(name); if p then return p end
                end
            end
        end
        return nil
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local c = p.Character; local root = c:FindFirstChild("HumanoidRootPart"); local h = c:FindFirstChild("Humanoid")
            if root and h and h.Health > 0 then
                if p:FindFirstChild("Backpack") and p.Backpack:FindFirstChild("Knife") then return p end
                for _, t in ipairs(c:GetChildren()) do if t:IsA("Tool") and t.Name == "Knife" then return p end end
            end
        end
    end
    return nil
end

local function fireOnce(targetPos)
    local cam = workspace.CurrentCamera
    if not cam then return end
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local gunF = remotes and remotes:FindFirstChild("Gun")
    local remote = gunF and gunF:FindFirstChild("Shoot")
    if remote then pcall(function() remote:FireServer(targetPos, cam.CFrame) end) end
    
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local gun = char:FindFirstChild("Gun") or (bp and bp:FindFirstChild("Gun"))
    if gun and gun:IsA("Tool") and hum then
        if gun.Parent ~= char then pcall(function() hum:EquipTool(gun) end); RunService.Heartbeat:Wait() end
        pcall(function() gun:Activate() end)
        pcall(function() local vu = game:GetService("VirtualUser"); vu:Button1Down(Vector2.zero); vu:Button1Up(Vector2.zero) end)
        if Config.AutoUnequip then
            task.delay(0.2, function()
                if gun and gun.Parent == char and hum then pcall(function() hum:UnequipTools() end) end
            end)
        end
    end
end

local flickToken = 0
local isProcessing = false

local function flickToMurderer()
    if not Config.Enabled or isProcessing then return end
    local murderer = findMurderer()
    if not murderer or not murderer.Character then notify("Murderer not found", 1) return end
    
    local cam = workspace.CurrentCamera
    local char = LocalPlayer.Character
    if not cam or not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end
    
    local targetPart = murderer.Character:FindFirstChild(Config.TargetPart) or murderer.Character:FindFirstChild("HumanoidRootPart")
    if not targetPart then return end

    local targetPos = computeTargetPosition(targetPart)
    if not targetPos then return end
    if Config.WallCheck and isWallBlocked(targetPos) then notify("Target behind wall", 1) return end

    isProcessing = true
    flickToken = flickToken + 1
    local myToken = flickToken
    local startOffset = cam.CFrame.Position - root.Position
    
    local oldAutoRotate = hum.AutoRotate
    hum.AutoRotate = false

    if Config.RotateBody then
        local dir = Vector3.new(targetPos.X, root.Position.Y, targetPos.Z) - root.Position
        if dir.Magnitude > 0.01 then
            if Config.InstantFlick then
                root.CFrame = CFrame.lookAt(root.Position, root.Position + dir.Unit)
            else
                local startCF = root.CFrame
                local targetCF = CFrame.lookAt(root.Position, root.Position + dir.Unit)
                local t0 = tick()
                local dur = math.clamp(1 / (Config.FlickSpeed / 100), 0.01, 0.5)
                while tick() - t0 < dur and myToken == flickToken do
                    if not root.Parent then break end
                    root.CFrame = startCF:Lerp(targetCF, (tick() - t0) / dur)
                    RunService.RenderStepped:Wait()
                end
            end
        end
    end

    local bindName = "FlickCam_" .. myToken
    local isFinished = false

    cam.CameraType = Enum.CameraType.Scriptable
    RunService:BindToRenderStep(bindName, Enum.RenderPriority.Camera.Value + 1, function()
        if isFinished or myToken ~= flickToken then RunService:UnbindFromRenderStep(bindName); return end
        local curRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if curRoot then
            cam.CFrame = CFrame.lookAt(curRoot.Position + startOffset, targetPos)
        end
    end)

    RunService.Heartbeat:Wait()
    if myToken ~= flickToken then isProcessing = false; return end

    if Config.AutoShoot then fireOnce(targetPos) end

    task.delay(Config.ReturnDelay / 1000, function()
        if myToken ~= flickToken then return end
        isFinished = true
        RunService:UnbindFromRenderStep(bindName)
        cam.CameraType = Enum.CameraType.Custom
        if hum and hum.Parent then
            cam.CameraSubject = hum
            hum.AutoRotate = oldAutoRotate
        end
        isProcessing = false
    end)
end

local waitingForBind = false
local function setupKeybind()
    if getgenv().FlickKeybindConn then pcall(function() getgenv().FlickKeybindConn:Disconnect() end) end
    getgenv().FlickKeybindConn = UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if waitingForBind then
            waitingForBind = false
            if input.KeyCode ~= Enum.KeyCode.Unknown then Config.Keybind = input.KeyCode.Name; notify("Keybind: " .. Config.Keybind, 1) end
            return
        end
        if input.KeyCode == Enum.KeyCode[Config.Keybind] then task.spawn(flickToMurderer) end
    end)
end

